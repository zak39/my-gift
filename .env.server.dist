# Every variable a server must give, for .env.prod.local or .env.preprod.local (out of git):
#   cp .env.server.dist .env.preprod.local, then fill it in.
# Docker Compose reads that file (env_file of compose.prod.yaml / compose.preprod.yaml) and
# hands it to the containers as real environment variables: there is no .env on a server,
# so a variable missing here has no default and breaks the pages that need it.
# Compose interpolates $ in unquoted and double-quoted values: quote a value holding a $
# with single quotes.

###> Symfony ###
# prod, or preprod (the « version de test » banner, with prod's settings).
APP_ENV=prod
# CSRF tokens, signed share links, « remember me »: openssl rand -hex 32. Its own on each
# server, or a preprod signed link would open on prod.
APP_SECRET=
# The app's own URL, for the absolute links of emails and share links (no trailing slash).
DEFAULT_URI=https://example.org
###< Symfony ###

###> Database ###
# Read by Postgres only when it creates its volume: changing them later changes nothing in
# an existing database. openssl rand -hex 24 for the password: no character to escape in
# DATABASE_URL.
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
# The same user, password and database. The host is the compose service, "database":
# 127.0.0.1 is the php container itself.
DATABASE_URL="postgresql://app:<POSTGRES_PASSWORD>@database:5432/app?serverVersion=16&charset=utf8"
###< Database ###

###> Messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< Messenger ###

###> Mailer ###
# Mailgun's API (symfony/mailgun-mailer); region=eu for a domain in Mailgun's EU region.
MAILER_DSN=mailgun+api://<API_KEY>:<DOMAIN>@default?region=eu
###< Mailer ###

# Not here: APP_VERSION, set by `castor deploy` to the tag it deploys (compose.*.yaml).
