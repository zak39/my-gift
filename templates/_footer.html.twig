<svg
  width="100%"
  height="100%"
  {# min-x min-y width height #}
  viewBox="0 0 1440 220"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true">
    <path d="M 0,400 L 0,150 C 144.8,137.2 289.6,124.4 464,128 C 638.4,131.6 842.4000000000001,151.6 1010,158 C 1177.6,164.4 1308.8,157.2 1440,150 L 1440,400 L 0,400 Z"
    class="fill-neutral" />
</svg>
{# What it says of the app and its maker: the `site` Twig global (config/packages/twig.yaml). #}
<footer class="bg-neutral text-neutral-content">
  <div class="footer md:footer-horizontal footer-vertical px-10 pb-10">
    {# Side by side (md), raised so the mark, taller than a footer-title, centres on the
       titles' row and the tagline falls on the first links' row. #}
    <aside class="md:-mt-2">
      <a href="{{ path('app_landing_page') }}">
        <twig:Molecule:Brand />
      </a>
      <p class="max-w-xs text-neutral-content/70">Des cadeaux qui ne font jamais doublon.</p>
    </aside>
    {# h2, not daisyUI's h6: these sections sit beside the page's own, under its h1 (RGAA 9.1);
       footer-title gives them their look. #}
    <nav>
      <h2 class="footer-title">My Gift</h2>
      <a href="{{ path('app_about') }}" class="link link-hover">À propos</a>
      <a href="{{ path('app_faq') }}" class="link link-hover">Questions fréquentes</a>
      <a href="mailto:{{ site.contact_email }}" class="link link-hover">Contact</a>
    </nav>
    <nav>
      <h2 class="footer-title">Informations légales</h2>
      <a href="{{ path('app_terms') }}" class="link link-hover">Conditions d'utilisation</a>
      <a href="{{ path('app_legal_notice') }}" class="link link-hover">Mentions légales</a>
      <a href="{{ path('app_privacy') }}" class="link link-hover">Politique de confidentialité</a>
    </nav>
    <nav>
      <h2 class="footer-title">Suivre</h2>
      <div class="flex gap-4">
        <twig:Molecule:Link newWindow :href="site.repository_url">
          <twig:ux:icon name="lucide:github" class="size-6" aria-hidden="true" />
          <span class="sr-only">Code source sur GitHub</span>
        </twig:Molecule:Link>
        <twig:Molecule:Link newWindow :href="site.linkedin_url">
          <twig:ux:icon name="lucide:linkedin" class="size-6" aria-hidden="true" />
          <span class="sr-only">{{ site.author_name }} sur LinkedIn</span>
        </twig:Molecule:Link>
      </div>
      <twig:Molecule:SupportButton class="btn-sm mt-2" />
    </nav>
  </div>
  {# Not a daisyUI footer: it makes each child a grid, which would stack every piece of
     this line (text, heart, link) on its own row. #}
  <div class="border-t border-neutral-content/10 p-4 text-center text-sm text-neutral-content/70">
    <p>
      © {{ 'now'|date('Y') }} My Gift · version {{ site.version }} · Fait avec
      <span role="img" aria-label="amour">❤</span> par
      <twig:Molecule:Link newWindow :href="site.linkedin_url" class="link link-hover">{{ site.author_name }}</twig:Molecule:Link>
    </p>
  </div>
</footer>
