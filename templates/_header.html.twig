<div class="navbar bg-base-100 shadow-sm px-4 sm:px-6 lg:px-8">
    <div class="navbar-start">
        <a class="btn btn-ghost text-xl" href={{ path('app_landing_page') }}>MyGift</a>
    </div>
    <div class="navbar-end">
        {% if not is_granted('IS_AUTHENTICATED') %}
            {# Navbar content for unauthenticated users #}
            <twig:Molecule:Navbar:Visitor />
        {% else %}
            {# Navbar for mobile view #}
            <twig:Molecule:Navbar:Mobile />
            {# Navbar for browser view #}
            <twig:Molecule:Navbar:Web />
            {# Navbar Avatar menu #}
            <twig:Molecule:Navbar:Avatar />
        {% endif %}
    </div>
</div>
