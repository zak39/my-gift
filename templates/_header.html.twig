<div class="navbar bg-base-100 shadow-sm px-4 sm:px-6 lg:px-8">
    <div class="navbar-start">
        <a class="btn btn-ghost gap-2 text-xl" href="{{ path('app_landing_page') }}">
            <twig:ux:icon name="fluent-color:gift-24" class="size-7" aria-hidden="true" />
            {# Modak has one weight: font-normal, or the browser fakes the btn's bold. Lowered
               on purpose (optical alignment): centred as a box, the « y » pulls the word's
               middle down, so its heavy capitals looked above the gift's body. #}
            <span class="font-brand text-3xl leading-none font-normal translate-y-[0.07em]">MyGift</span>
        </a>
    </div>
    <div class="navbar-end">
        {% if not is_granted('IS_AUTHENTICATED') %}
            {# Navbar content for unauthenticated users #}
            <twig:Molecule:Navbar:Visitor />
        {% else %}
            {# Navbar for mobile view #}
            <twig:Molecule:Navbar:Mobile />
            {# Navbar for browser view #}
            <twig:Molecule:Navbar:Web />
            {# Navbar Avatar menu #}
            <twig:Molecule:Navbar:Avatar />
            {# Opened from both menus above, outside them: a dialog in a closed dropdown or drawer is hidden with it #}
            <twig:Molecule:AboutModal />
        {% endif %}
    </div>
</div>
