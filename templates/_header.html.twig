<div class="navbar bg-base-100 shadow-sm px-4 sm:px-6 lg:px-8">
    <div class="flex-1">
        <a class="btn btn-ghost text-xl" href={{ path('app_landing_page') }}>MyGift</a>
    </div>
    <div class="flex gap-2">
        {# <input type="text" placeholder="Search" class="input input-bordered w-24 md:w-auto" /> #}
        <div class="dropdown dropdown-end">
            <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
                <twig:molecule:Avatar size="10">
                    <twig:block name="image">
                        {% if is_granted('IS_AUTHENTICATED') %}
                            <twig:atomic:Image id="user_avatar_header"
                                source="{{ app.user.avatar ? vich_uploader_asset(app.user, 'avatarFile') : vich_uploader_asset(app.user, 'avatarDefaultFile') }}"
                                alt="{{ 'Photo de profil ' ~ app.user.firstname ~ ' ' ~ app.user.lastname  }}" />
                        {% else %}
                            <twig:ux:icon name="solar:user-bold" class="size-7" />
                        {% endif %}
                    </twig:block>
                </twig:molecule:Avatar>
            </div>
            <ul
                tabindex="-1"
                class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
                {% if is_granted('IS_AUTHENTICATED') %}
                    <li>
                    <a class="justify-between" href={{ path('app_user_profile') }}>
                        Profile
                        <span class="badge">New</span>
                    </a>
                    </li>
                    <li><a href={{ path('app_gift') }}>Mes cadeaux</a></li>
                    <li><a href={{ path('app_section') }}>Mes listes</a></li>
                    <li><a>Settings</a></li>
                    <li><a href={{ path('app_logout') }}>Se déconnecter</a></li>
                {% else %}
                    <li>
                        <a class="justify-between" href={{ path('app_login') }}>
                            Se connecter
                        </a>
                    </li>                    
                {% endif %}
            </ul>
        </div>
    </div>
</div>