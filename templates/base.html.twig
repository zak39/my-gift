<!DOCTYPE html>
{# Rendered from the theme cookie, no flash of the wrong theme on load. None for "system":
   daisyUI then follows prefers-color-scheme. #}
{% set daisyTheme = current_theme().daisyTheme %}
<html{% if daisyTheme %} data-theme="{{ daisyTheme }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}My Gift | Welcome!{% endblock %}</title>
        {# linkPreview: the card of a shared link opened while logged out (SharedLinkPreviewListener). #}
        <twig:Molecule:LinkPreview :preview="linkPreview ?? null" />
        {# The logo's gift. The SVG for the browsers that take one; sizes="32x32" keeps the
           others on the .ico without them preferring it to the SVG. favicon.ico stays at the
           root (public/), where browsers ask for it on their own; the iOS home screen wants
           a PNG on white (assets/images/). #}
        <link rel="icon" href="/favicon.ico" sizes="32x32">
        <link rel="icon" href="{{ asset('icons/fluent-color/gift-24.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-base-200">
        {# Outside the header block: a page without the navbar still says it is a test version. #}
        <twig:Molecule:TestBanner />
        {% block header %}{{ include('./_header.html.twig') }}{% endblock %}
            <main class="px-4 sm:px-6 lg:px-8">
                {% block body %}{% endblock %}
            </main>
        {{ include('./_footer.html.twig') }}
    </body>
</html>
