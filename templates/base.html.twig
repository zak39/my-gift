<!DOCTYPE html>
{# Rendered from the theme cookie, no flash of the wrong theme on load. None for "system":
   daisyUI then follows prefers-color-scheme. #}
{% set daisyTheme = current_theme().daisyTheme %}
<html lang="fr"{% if daisyTheme %} data-theme="{{ daisyTheme }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}My Gift{% endblock %}</title>
        {# The text under the title in search results: a public page (IndexablePages) tells its
           own, about 150 characters, Google cutting the rest. #}
        <meta name="description" content="{% block description %}{{ site.description }}{% endblock %}">
        {# The URL search engines keep: the same without its query string (/login?invitation=…
           is /login). #}
        {% if is_indexable_route(app.current_route) %}
            <link rel="canonical" href="{{ url(app.current_route) }}">
        {% endif %}
        {# linkPreview: the card of a shared link opened while logged out (SharedLinkPreviewListener). #}
        <twig:Molecule:LinkPreview :preview="linkPreview ?? null" />
        {# The logo's gift. The SVG for the browsers that take one; sizes="32x32" keeps the
           others on the .ico without them preferring it to the SVG. favicon.ico stays at the
           root (public/), where browsers ask for it on their own; the iOS home screen wants
           a PNG on white (assets/images/). #}
        <link rel="icon" href="/favicon.ico" sizes="32x32">
        <link rel="icon" href="{{ asset('icons/fluent-color/gift-24.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-base-200">
        {# First focusable element: a keyboard user skips the banner and the navbar (RGAA 12.7). #}
        <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-box focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-content focus:shadow-lg">Aller au contenu</a>
        {# Outside the header block: a page without the navbar still says it is a test version. #}
        <twig:Molecule:TestBanner />
        {% block header %}{{ include('./_header.html.twig') }}{% endblock %}
        {# RGAA 7.5: reads the success messages of each page, kept from page to page so that
           filling it is read (flash-announcer controller). #}
        <div id="flash-announcer" class="sr-only" role="status" data-turbo-permanent data-controller="flash-announcer"></div>
            {# tabindex="-1": the skip link moves the focus here, not only the scroll, where neither
               Turbo nor the browser does it (RGAA 12.7); not reached by Tab, no outline drawn. #}
            <main id="contenu" tabindex="-1" class="px-4 sm:px-6 lg:px-8 focus:outline-none">
                {% block body %}{% endblock %}
            </main>
        {{ include('./_footer.html.twig') }}
    </body>
</html>
