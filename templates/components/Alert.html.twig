{# RGAA 7.5: an error interrupts (role="alert"), read even when it comes with the page. A
   success is only told, through the page's status region (flash-announcer controller, in
   base.html.twig), which outlives a Turbo visit: a role="status" coming with the page would
   not be read. #}
<div{{ attributes }}>
    <div class="alert alert-{{ type }}" {% if type == 'error' %}role="alert"{% else %}data-flash-announce{% endif %}>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24" aria-hidden="true">
            {% if type == 'error' %}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            {% else %}
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            {% endif %}
        </svg>
        <span>{{ message }}</span>
    </div>
</div>
