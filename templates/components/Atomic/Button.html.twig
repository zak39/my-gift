<button {{ attributes.defaults({
        class: "btn"
            ~ (style|default('') ? " btn-" ~ style : "")
            ~ (color|default('') ? " btn-" ~ color : "")
            ~ (wide|default(false) ? " btn-wide" : ""),
        type: "button"}) }}>
    {% block icon %}{% endblock %}
    {% block name %}{% endblock %}
</button>
