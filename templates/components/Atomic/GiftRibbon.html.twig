{# At the top of a rounded-box card, it rounds its own corners: a card can then drop its
   overflow-hidden, which would clip a "…" menu in it. #}
<div aria-hidden="true"
    {{ attributes.defaults({ class: 'h-2.5 w-full rounded-t-box bg-[repeating-linear-gradient(135deg,var(--color-ribbon-pink)_0_0.75rem,var(--color-ribbon-blue)_0.75rem_1.5rem)]' }) }}></div>
