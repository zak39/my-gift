<div{{ attributes }}>
    <div class="card card-xs lg:card-side bg-base-100 shadow-sm">
        {% if gift.isPublic %}
            <figure>
            <img
                class="md:size-104 size-95 md:object-contain object-cover"
                src={{ gift.image ? vich_uploader_asset(gift, 'imageFile') : "https://img.daisyui.com/images/stock/photo-1494232410401-ad00d5433cfa.webp" }}
                alt={{ gift.title }} />
            </figure>
        {% else %}
            <div class="indicator">
                <span class="indicator-item indicator-center indicator-middle badge badge-warning badge-xl tooltip font-bold"
                    data-tip="Les utilisateurs ne pourront pas voir ce cadeau">
                    <svg class="size-[1em]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18"><g fill="currentColor"><path d="M7.638,3.495L2.213,12.891c-.605,1.048,.151,2.359,1.362,2.359H14.425c1.211,0,1.967-1.31,1.362-2.359L10.362,3.495c-.605-1.048-2.119-1.048-2.724,0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><line x1="9" y1="6.5" x2="9" y2="10" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></line><path d="M9,13.569c-.552,0-1-.449-1-1s.448-1,1-1,1,.449,1,1-.448,1-1,1Z" fill="currentColor" data-stroke="none" stroke="none"></path></g></svg>
                    Non publié
                </span>
                <figure>
                    <img
                        class="md:size-104 size-95 md:object-contain object-cover opacity-50"
                        src={{ gift.image ? vich_uploader_asset(gift, 'imageFile') : "https://img.daisyui.com/images/stock/photo-1494232410401-ad00d5433cfa.webp" }}
                        alt={{ gift.title }} />
                </figure>
            </div>
        {% endif %}
        <div class="card-body ml-2">
            <div class="flex justify-between items-center gap-3">
                <h2 class="card-title">
                    <span class="md:text-xl text-lg">{{ gift.title }}</span>
                </h2>
                <button class="btn btn-circle btn-soft btn-secondary">
                    <twig:ux:icon name="rivet-icons:heart" />
                </button>
            </div>
            <div>
                <span class="badge badge-lg badge-accent">
                    {{ gift.price|format_currency('EUR') }}
                </span>
            </div>
            {% if gift.link %}
                <p class="md:w-2xl md:text-lg text-sm md:line-clamp-4 hidden">
                    {{ gift.description }}
                </p>
            {% else %}
                <p class="md:w-2xl md:text-lg text-sm md:line-clamp-7 hidden">
                    {{ gift.description }}
                </p>
            {% endif %}
            {% if gift.link %}
                <a href="{{ gift.link }}" class="btn btn-primary md:w-2xs w-full md:my-2">
                    <twig:block name="icon">
                        <twig:ux:icon name="akar-icons:link-out" />
                    </twig:block>
                Aller sur la boutique
                </a>
            {% endif %}
            <div class="card-actions justify-start md:mb-2 md:mt-2 mb-4 mt-4">
                <div class="badge badge-outline badge-accent">Video game</div>
                <div class="badge badge-outline badge-accent">Funny</div>
            </div>
            <div class="card-actions justify-end mr-4 mb-4">
                <twig:atomic:Button name="Share"
                    data-controller="copy"
                    data-copy-text-value="{{ absolute_url(path('app_gift_show', { 'id': gift.id })) }}"
                    data-action="click->copy#copy"
                    type="primary">
                    <twig:block name="icon">
                    <span data-copy-target="icon">
                        <twig:ux:icon name="lucide:share" />
                    </span>
                    </twig:block>
                </twig:atomic:Button>
                <twig:atomic:Button:Soft name="Give"
                    type="secondary">
                    <twig:block name="icon">
                        <twig:ux:icon name="famicons:gift" />
                    </twig:block>
                </twig:atomic:Button:Soft>
                <twig:atomic:Button:Soft name="Participate"
                    type="secondary">
                    <twig:block name="icon">
                        <twig:ux:icon name="ri:hand-coin-fill" />
                    </twig:block>
                </twig:atomic:Button:Soft>
                <twig:atomic:Button:Outline name="Voir"
                    to="app_gift_show"
                    :parameters="{ id: gift.id }"
                    type="secondary">
                    <twig:block name="icon">
                        <twig:ux:icon name="fluent:eye-12-filled" />
                    </twig:block>
                </twig:atomic:Button:Outline>
                <twig:atomic:Button:Outline name="Edit"
                    type="secondary"
                    to="app_gift_edit"
                    :parameters="{ id: gift.id }">
                    <twig:block name="icon">
                        <twig:ux:icon name="ic:baseline-edit" />
                    </twig:block>
                </twig:atomic:Button:Outline>
                <twig:Modal title="Supprimer un cadeau"
                    class="remove_gift"
                    :id="gift.id">
                    <twig:block name="message">
                        <p class="py-4">Est-ce que vous êtes sûr de supprimer le cadeau <b>{{ gift.title }}</b> ?</p>
                    </twig:block>
                    <twig:block name="actionButtons">
                        <form method="post" action="{{ path('app_gift_delete', { id: gift.id }) }}">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-outline btn-secondary">
                                <twig:ux:icon name="heroicons:trash-16-solid" />
                                Supprimer
                            </button>
                        </form>
                    </twig:block>
                </twig:Modal>
            </div>
        </div>
    </div>
</div>
