<div{{ attributes }}>
    <div class="card card-xs lg:card-side bg-base-100 shadow-sm">
        <twig:Organism:Gift:Thumbnail :gift="gift" />
        <div class="card-body ml-2">
            <div class="flex justify-between items-center gap-3">
                <h2 class="card-title">
                    <span class="md:text-xl text-lg">{{ gift.title }}</span>
                </h2>

                <twig:Molecule:Gift:FavoriteButton :gift="gift" :isFavorite="app.user.hasFavoriteGift(gift)" />
            </div>
            <div class="md:my-0 my-4">
                <span class="badge badge-lg badge-neutral">
                    {{ gift.price|format_currency('EUR') }}
                </span>
            </div>
            {% if gift.link %}
                <p class="md:w-2xl md:text-lg text-sm md:line-clamp-4 hidden">
                    {{ gift.description }}
                </p>
            {% else %}
                <p class="md:w-2xl md:text-lg text-sm md:line-clamp-7 hidden">
                    {{ gift.description }}
                </p>
            {% endif %}

            <twig:Molecule:Gift:ParticipationStatus :gift="gift" />

            {% if gift.getParticipant(app.user) %}
                <p>Vous participez déjà à ce cadeau</p>
            {% endif %}

            <div class="flex md:flex-row flex-col md:gap-6 gap-4 justify-end items-center md:my-8 my-6">
                <twig:Molecule:Gift:StatusButtons :gift="gift" />
            </div>

            {% if workflow_has_marked_place(gift, 'archived') %}
                <div class="card-actions justify-start md:my-2 md:mt-2 my-4">
                    <div class="badge badge-outline badge-neutral">Archivé</div>
                </div>
            {% endif %}

            <div class="card-actions justify-end mr-4 mb-4">
                <twig:Molecule:Gift:ShareLinkButton :gift="gift" :hideLabelOnMobile="true" />
                {% if gift.link %}
                    <twig:Molecule:Gift:LinkButton :gift="gift" :hideLabelOnMobile="true" />
                {% endif %}
                <twig:Molecule:Gift:ShowButton :gift="gift" :hideLabelOnMobile="true" />
                <twig:Molecule:Gift:EditButton :gift="gift" :hideLabelOnMobile="true" />
                <twig:Molecule:Gift:DeleteButton :gift="gift" :hideLabelOnMobile="true" />
            </div>
        </div>
    </div>
</div>
