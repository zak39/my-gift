<div{{ attributes }} class="contents">
    {% block handlerButton %}
    {% endblock %}
    <dialog id="modal_{{ class }}_{{ id }}" class="modal modal-bottom sm:modal-middle">
        <div class="modal-box">
            <h3 class="text-lg font-bold">{{ title }}</h3>
            {% block message %}
            {% endblock %}
            <div class="modal-action flex-col gap-6">
                <div class="flex flex-row justify-between gap-2">
                    {% block actionButtons %}
                    {% endblock %}
                </div>
                <form class="self-end" method="dialog">
                    <button class="btn btn-outline btn-neutral">Fermer</button>
                </form>
            </div>
        </div>
    </dialog>
</div>
