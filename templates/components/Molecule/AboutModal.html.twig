{# Opened from the menus by the dialog controller. #}
<twig:Modal title="À propos" class="about">
    <twig:block name="message">
        <div class="flex flex-col items-center gap-2 py-6 text-center">
            <twig:Molecule:Brand size="lg" class="flex-col" />
            <p class="badge badge-ghost">Version {{ site.version }}</p>
            <p class="text-sm text-muted">
                Fait par {{ site.author_name }} ·
                <a href="{{ path('app_about') }}" class="link">Tout savoir sur My Gift</a>
            </p>
        </div>
        <twig:Molecule:AboutLinks />
    </twig:block>
</twig:Modal>
