{# Inside the Modal blocks, this is Modal: the values come from the props of this component,
   exposed under names Modal does not use. Opened from the menus by the dialog controller. #}
<twig:Modal title="À propos" class="about">
    <twig:block name="message">
        <div class="flex flex-col items-center gap-2 py-6 text-center">
            <twig:ux:icon name="fluent-color:gift-24" class="size-16" aria-hidden="true" />
            <p class="text-2xl font-bold">My Gift</p>
            <p class="badge badge-ghost">Version {{ version }}</p>
        </div>
        <ul class="menu w-full rounded-box bg-base-200">
            <li>
                <a href="{{ repositoryUrl }}" target="_blank" rel="noopener">
                    <twig:ux:icon name="lucide:github" class="size-4" aria-hidden="true" />
                    Code source sur GitHub
                </a>
            </li>
            <li>
                <a href="mailto:{{ contactEmail }}">
                    <twig:ux:icon name="lucide:mail" class="size-4" aria-hidden="true" />
                    Me contacter
                </a>
            </li>
        </ul>
        {# Buy Me a Coffee's own button script writes itself with document.writeln(), which a
           Turbo visit ignores: the same button, as a plain link. #}
        <div class="mt-4 flex justify-center">
            <a href="{{ supportUrl }}" target="_blank" rel="noopener"
               class="btn border-none bg-[#FFDD00] text-black hover:bg-[#FFDD00]/80">
                <span aria-hidden="true">🍵</span>
                Buy me a matcha
            </a>
        </div>
    </twig:block>
</twig:Modal>
