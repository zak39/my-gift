<ul {{ attributes.defaults({ class: 'space-y-6' }) }}>
    {% for item in items %}
        <li class="flex items-start gap-4">
            <span class="{{ iconClass }} rounded-box grid size-9 shrink-0 place-content-center">
                <twig:ux:icon name="lucide:check" class="size-5" />
            </span>
            <span class="text-muted text-lg">{{ item }}</span>
        </li>
    {% endfor %}
</ul>
