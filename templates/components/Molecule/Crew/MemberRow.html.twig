{% set member = membership.user %}
<li {{ attributes.defaults({ class: 'list-row items-center' }) }}>
    <twig:Molecule:UserAvatar :user="member" sizeClass="w-10" />

    <div class="min-w-0">
        <p class="font-medium">
            {% if member is same as(app.user) %}
                <span class="wrap-anywhere">{{ member.pseudo }}</span>
                <span class="text-sm font-normal text-muted">(vous)</span>
            {% else %}
                <twig:Molecule:User:Name :user="member" />
            {% endif %}
        </p>
        <p class="text-xs text-muted">Membre depuis le {{ membership.joinedAt|date('d/m/Y') }}</p>
        {# The role in accent, the history plain: the creator has no right of their own. #}
        {% if membership.owner or membership.creator %}
            <div class="mt-1.5 flex flex-wrap gap-1.5">
                {% if membership.owner %}
                    <span class="badge badge-sm badge-accent">Propriétaire</span>
                {% endif %}
                {% if membership.creator %}
                    <span class="badge badge-sm">Créateur·rice</span>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% set canSeeSections = is_granted('user.can_see_gifts', member) %}
    {% set canTransfer = is_granted('crew.can_transfer', membership.crew) %}
    {% if member is not same as(app.user) and (canSeeSections or canTransfer) %}
        {# The entry opening the modal goes through the dialog controller, the modal itself
           rendered below, out of the menu. #}
        <twig:Molecule:MoreActions label="Plus d'actions pour {{ member.pseudo }}">
            {# The members of a crew are not all friends: their sections only for a friend,
               anyone else gets a 404 there. #}
            {% if canSeeSections %}
                <li>
                    <a href="{{ path('app_section_user_page', { id: member.id }) }}">
                        <twig:ux:icon name="lucide:arrow-right" class="size-4" />
                        Voir ses sections
                    </a>
                </li>
            {% endif %}
            {% if canTransfer %}
                <li>
                    <button type="button" data-controller="dialog" data-dialog-id-value="modal_crew_transfer_{{ member.id }}" data-action="dialog#open">
                        <twig:ux:icon name="lucide:crown" class="size-4" />
                        Nommer propriétaire
                    </button>
                </li>
            {% endif %}
        </twig:Molecule:MoreActions>
        {% if canTransfer %}
            <twig:Molecule:Crew:TransferModal :crew="membership.crew" :member="member" />
        {% endif %}
    {% endif %}
</li>
