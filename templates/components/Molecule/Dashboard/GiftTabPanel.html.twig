<div{{ attributes }} class="tab-content bg-base-100 border-base-300 p-4">
    {% set emptyAction = gifts is empty and emptyActionLabel and seeAllRoute %}

    {% if gifts is empty %}
        <p class="text-sm text-muted py-4">{{ emptyMessage }}</p>
    {% else %}
        <div class="flex flex-col gap-3">
            {% for gift in gifts %}
                <twig:Molecule:Gift:MiniCard :gift="gift" />
            {% endfor %}
        </div>
    {% endif %}

    {% if emptyAction %}
        {# The empty tab offers its one next step, centered, instead of "Voir tout". #}
        <div class="flex justify-center pb-4">
            <twig:Atomic:ButtonLink :to="seeAllRoute" color="primary">
                <twig:block name="name">{{ emptyActionLabel }}</twig:block>
            </twig:Atomic:ButtonLink>
        </div>
    {% elseif seeAllRoute %}
        <div class="flex justify-end mt-4">
            <twig:Atomic:ButtonLink
                class="btn-sm"
                :to="seeAllRoute"
                style="ghost"
            >
                <twig:block name="name">Voir tout</twig:block>
            </twig:Atomic:ButtonLink>
        </div>
    {% endif %}
</div>