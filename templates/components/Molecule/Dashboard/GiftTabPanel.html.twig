<div{{ attributes }} class="tab-content bg-base-100 border-base-300 p-4">
    {% if gifts is empty %}
        <p class="text-sm opacity-60 py-4">{{ emptyMessage }}</p>
    {% else %}
        <div class="flex flex-col gap-3">
            {% for gift in gifts %}
                <twig:Molecule:Gift:MiniCard :gift="gift" />
            {% endfor %}
        </div>
    {% endif %}

    {% if seeAllRoute %}
        <div class="flex justify-end mt-4">
            <twig:atomic:ButtonLink
                class="btn-sm"
                :to="seeAllRoute"
                style="ghost"
            >
                <twig:block name="name">Voir tout</twig:block>
            </twig:atomic:ButtonLink>
        </div>
    {% endif %}
</div>