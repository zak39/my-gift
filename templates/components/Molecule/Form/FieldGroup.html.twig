<section {{ attributes.defaults({ class: 'grid gap-x-8 gap-y-4 border-t border-base-300 p-5 sm:p-7' ~ (stacked ? '' : ' md:grid-cols-[12rem_minmax(0,1fr)]') }) }}>
    <div>
        <h2 class="font-semibold">{{ title }}</h2>
        {% if description %}
            <p class="mt-1 text-sm text-muted">{{ description }}</p>
        {% endif %}
    </div>

    <div class="flex min-w-0 flex-col gap-4">
        {% block content %}{% endblock %}
    </div>
</section>
