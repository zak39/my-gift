{# One branch per FriendRelation case, worked out once by the component class. #}
{% set Relation = enum('App\\Enum\\FriendRelation') %}
{% set relation = this.relation %}
{% set pendingRequest = this.pendingRequest %}
{% set blockQuestion = 'Bloquer ' ~ user.firstname ~ ' ? Tout lien entre vous sera supprimé, et ' ~ user.firstname ~ ' ne pourra plus vous envoyer de demande.' %}

<div {{ attributes.defaults({ class: 'flex flex-wrap items-center gap-2' }) }}>
    {% if relation is same as(Relation.FRIEND) %}
        <span class="badge badge-success gap-1.5">
            <twig:ux:icon name="lucide:user-check" />
            Ami·e
        </span>
        <twig:Molecule:Friend:UnlinkButton :user="user" action="remove" label="Retirer" icon="lucide:user-minus"
            question="Retirer {{ user.firstname }} de vos ami·es ? Vous ne verrez plus vos sections respectives." />
        <twig:Molecule:Friend:UnlinkButton :user="user" action="block" label="Bloquer" icon="lucide:ban" :question="blockQuestion" />

    {% elseif relation is same as(Relation.BLOCKED) %}
        <span class="badge badge-error gap-1.5">
            <twig:ux:icon name="lucide:ban" />
            Bloqué·e
        </span>
        <form method="post" action="{{ path('app_friend_action', { id: user.id, action: 'unblock' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-unblock-' ~ user.id) }}">
            <button type="submit" class="btn btn-sm btn-outline btn-neutral">
                <twig:ux:icon name="lucide:lock-open" class="size-4" />
                Débloquer
            </button>
        </form>

    {% elseif relation is same as(Relation.REQUEST_RECEIVED) %}
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'accept' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-accept-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-primary">
                <twig:ux:icon name="lucide:check" class="size-4" />
                Accepter
            </button>
        </form>
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'refuse' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-refuse-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost">
                <twig:ux:icon name="lucide:x" class="size-4" />
                Refuser
            </button>
        </form>
        <twig:Molecule:Friend:UnlinkButton :user="user" action="block" label="Bloquer" icon="lucide:ban" :question="blockQuestion" />

    {% elseif relation is same as(Relation.REQUEST_SENT) %}
        <span class="badge badge-info gap-1.5">
            <twig:ux:icon name="lucide:clock" />
            En attente
        </span>
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'cancel' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-cancel-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost">
                <twig:ux:icon name="lucide:undo-2" class="size-4" />
                Annuler la demande
            </button>
        </form>

    {% else %}
        <form method="post" action="{{ path('app_friend_action', { id: user.id, action: 'send' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-send-' ~ user.id) }}">
            <button type="submit" class="btn btn-sm btn-primary">
                <twig:ux:icon name="lucide:user-plus" class="size-4" />
                Ajouter
            </button>
        </form>
    {% endif %}
</div>
