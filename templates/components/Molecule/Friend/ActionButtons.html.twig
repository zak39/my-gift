{# One branch per FriendRelation case, worked out once by the component class. #}
{% set Relation = enum('App\\Enum\\FriendRelation') %}
{% set relation = this.relation %}
{% set blockQuestion = 'Bloquer ' ~ user.pseudo ~ ' ? Tout lien entre vous sera supprimé, et ' ~ user.pseudo ~ ' ne pourra plus vous envoyer de demande.' %}

<div {{ attributes.defaults({ class: 'flex flex-wrap items-center gap-2' }) }}>
    {% if relation is same as(Relation.FRIEND) %}
        <span class="badge badge-success gap-1.5">
            <twig:ux:icon name="lucide:user-check" />
            Ami·e
        </span>
        {# Their sections, under the rule of their page: anyone else gets a 404 there. #}
        {% if is_granted('user.can_see_gifts', user) %}
            <twig:Atomic:ButtonLink class="btn-sm" style="ghost" :to="path('app_section_user_page', { id: user.id })">
                <twig:block name="name">
                    <span>Voir ses sections</span>
                </twig:block>
                <twig:block name="icon">
                    <twig:ux:icon name="lucide:arrow-right" class="size-4" />
                </twig:block>
            </twig:Atomic:ButtonLink>
        {% endif %}
        {# Removing and blocking are rare and final: they wait behind "…", last (RGAA 12.8: the
           tab order follows the one on screen), each entry opening the modal of its
           UnlinkButton below. #}
        <twig:Molecule:MoreActions label="Plus d'actions pour {{ user.pseudo }}" class="{{ menuClass }}">
            <li>
                <button type="button" data-controller="dialog" data-dialog-id-value="modal_friend_remove_{{ user.id }}" data-action="dialog#open">
                    <twig:ux:icon name="lucide:user-minus" class="size-4" />
                    Retirer
                </button>
            </li>
            <li>
                <button type="button" class="text-error" data-controller="dialog" data-dialog-id-value="modal_friend_block_{{ user.id }}" data-action="dialog#open">
                    <twig:ux:icon name="lucide:ban" class="size-4" />
                    Bloquer
                </button>
            </li>
        </twig:Molecule:MoreActions>
        <twig:Molecule:Friend:UnlinkButton :user="user" action="remove" label="Retirer" icon="lucide:user-minus" :withTrigger="false"
            question="Retirer {{ user.pseudo }} de vos ami·es ? Vous ne verrez plus vos sections respectives." />
        <twig:Molecule:Friend:UnlinkButton :user="user" action="block" label="Bloquer" icon="lucide:ban" :withTrigger="false" :question="blockQuestion" />

    {% elseif relation is same as(Relation.BLOCKED) %}
        <span class="badge badge-error gap-1.5">
            <twig:ux:icon name="lucide:ban" />
            Bloqué·e
        </span>
        <form method="post" action="{{ path('app_friend_action', { id: user.id, action: 'unblock' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-unblock-' ~ user.id) }}">
            <button type="submit" class="btn btn-sm btn-outline">
                <twig:ux:icon name="lucide:lock-open" class="size-4" />
                Débloquer
            </button>
        </form>

    {% elseif relation is same as(Relation.REQUEST_RECEIVED) %}
        {% set pendingRequest = this.pendingRequest %}
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'accept' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-accept-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-primary">
                <twig:ux:icon name="lucide:check" class="size-4" />
                Accepter
            </button>
        </form>
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'refuse' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-refuse-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost">
                <twig:ux:icon name="lucide:x" class="size-4" />
                Refuser
            </button>
        </form>
        {# Blocking stays in sight here: to a stranger's request, it is an answer like refusing. #}
        <twig:Molecule:Friend:UnlinkButton :user="user" action="block" label="Bloquer" icon="lucide:ban" :question="blockQuestion" />

    {% elseif relation is same as(Relation.REQUEST_SENT) %}
        {% set pendingRequest = this.pendingRequest %}
        <span class="badge badge-info gap-1.5">
            <twig:ux:icon name="lucide:clock" />
            En attente
        </span>
        <form method="post" action="{{ path('app_friend_request', { id: pendingRequest.id, transition: 'cancel' }) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('friend-request-cancel-' ~ pendingRequest.id) }}">
            <button type="submit" class="btn btn-sm btn-ghost">
                <twig:ux:icon name="lucide:undo-2" class="size-4" />
                Annuler la demande
            </button>
        </form>

    {% else %}
        {# A stranger: nothing here, but for a caller that may ask them, the invitation page. #}
        {% block stranger %}{% endblock %}
    {% endif %}
</div>
