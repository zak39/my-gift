<div {{ attributes.defaults({ class: 'flex flex-wrap items-center gap-2' }) }}>
    <twig:Molecule:Gift:StatusBadge :gift="gift" />

    {% if is_granted('gift.is_owner', gift) %}
        {% if gift.isPublic %}
            <span class="badge badge-ghost gap-1.5">
                <twig:ux:icon name="lucide:eye" />
                Visible par tous
            </span>
        {% else %}
            <span class="badge badge-warning gap-1.5">
                <twig:ux:icon name="lucide:eye-off" />
                Non publié
            </span>
        {% endif %}
    {% endif %}
</div>
