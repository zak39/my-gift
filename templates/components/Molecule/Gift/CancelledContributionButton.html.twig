<div{{ attributes }} class="contents">
    {% if workflow_can(gift, 'cancelled_contribution') %}
        <form method="post" action="{{ path('app_gift_cancelled_contribution', { id: gift.id }) }}">
            <input type="hidden"
                name="_token"
                value="{{ csrf_token('cancelled-contribution-gift-' ~ gift.id) }}">
            <button type="submit" class="btn btn-accent md:w-52 w-full">
                <twig:ux:icon name="ri:hand-coin-off-fill" />
                Annuler les contributions
            </button>
        </form>
    {% endif %}
</div>