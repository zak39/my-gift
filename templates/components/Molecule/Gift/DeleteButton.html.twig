<div{{ attributes }} class="contents">
    <twig:Modal title="Supprimer un cadeau"
        class="remove_gift"
        :id="gift.id">
        <twig:block name="handlerButton">
            <twig:atomic:Button class="btn-{{ style }}"
                onclick="modal_remove_gift_{{ gift.id }}.showModal()"
                type="secondary">
                <twig:block name="icon">
                    <twig:ux:icon name="heroicons:trash-16-solid" />
                </twig:block>
                <twig:block name="name">
                    <span class="{{ hideLabelOnMobile ? 'md:block hidden' : '' }}">Supprimer</span>
                </twig:block>
            </twig:atomic:Button>
        </twig:block>
        <twig:block name="message">
            <p class="py-4">Est-ce que vous êtes sûr de supprimer le cadeau <b>{{ gift.title }}</b> ?</p>
        </twig:block>
        <twig:block name="actionButtons">
            <form method="post" action="{{ path('app_gift_delete', { id: gift.id }) }}">
                <input type="hidden" name="_method" value="DELETE">
                <button type="submit" class="btn btn-error">
                    <twig:ux:icon name="heroicons:trash-16-solid" />
                    Supprimer
                </button>
            </form>
        </twig:block>
    </twig:Modal>
</div>
