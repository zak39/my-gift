<div {{ attributes.defaults({ class: 'contents' }) }}>
    <twig:Modal title="Supprimer un cadeau"
        class="remove_gift"
        :id="gift.id">
        <twig:block name="handlerButton">
            {# The tooltip wraps the button only: the dialog is not inside it. #}
            <span class="{{ iconOnly ? 'inline-block' : 'contents' }}"
                {% if iconOnly %}data-controller="tooltip" data-tooltip-text-value="Supprimer le cadeau"{% endif %}>
            <twig:Atomic:Button :style="style"
                class="{{ iconOnly ? 'btn-circle' : '' }}"
                onclick="modal_remove_gift_{{ gift.id }}.showModal()"
                :color="color">
                <twig:block name="icon">
                    <twig:ux:icon name="heroicons:trash-16-solid" />
                </twig:block>
                <twig:block name="name">
                    <span class="{{ iconOnly ? 'sr-only' : '' }}">Supprimer</span>
                </twig:block>
            </twig:Atomic:Button>
            </span>
        </twig:block>
        <twig:block name="message">
            <p class="py-4">Est-ce que vous êtes sûr de supprimer le cadeau <b>{{ gift.title }}</b> ?</p>
            {# The same sentence for every gift: telling it apart would reveal a pool that
               GiftPoolVoter hides from its owners. #}
            <p class="pb-4 text-sm text-muted">Si des personnes participent à ce cadeau, elles seront prévenues par email.</p>
        </twig:block>
        <twig:block name="actionButtons">
            <form method="post" action="{{ gift_delete_url(gift) }}">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_token" value="{{ csrf_token('gift-delete-' ~ gift.id) }}">
                <twig:Atomic:BackField :url="back" />
                <button type="submit" class="btn btn-error">
                    <twig:ux:icon name="heroicons:trash-16-solid" />
                    Supprimer
                </button>
            </form>
        </twig:block>
    </twig:Modal>
</div>
