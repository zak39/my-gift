{% set wrapper = iconOnly
    ? { class: 'inline-block', 'data-controller': 'tooltip', 'data-tooltip-text-value': 'Editer le cadeau' }
    : { class: 'contents' } %}

<div {{ attributes.defaults(wrapper) }}>
    <twig:Atomic:ButtonLink
        :style="style"
        class="{{ iconOnly ? 'btn-circle' : '' }}"
        :to="gift_edit_url(gift)"
        :color="color">
        <twig:block name="icon">
            <twig:ux:icon name="ic:baseline-edit" />
        </twig:block>
        <twig:block name="name">
            <span class="{{ iconOnly ? 'sr-only' : '' }}">Editer</span>
        </twig:block>
    </twig:Atomic:ButtonLink>
</div>
