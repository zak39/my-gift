{% if is_granted('gift.is_owner', gift) == false %}
    <button {{ attributes.defaults({ class: 'btn btn-circle btn-ghost' }) }}
        type="button"
        aria-pressed="{{ this.isFavorite ? 'true' : 'false' }}"
        aria-label="{{ this.isFavorite ? 'Retirer ce cadeau de mes favoris' : 'Ajouter ce cadeau à mes favoris' }}"
        data-controller="favorite"
        data-favorite-id-value="{{ gift.id }}"
        data-favorite-is-favorite-value="{{ this.isFavorite ? 'true' : 'false' }}"
        {# One token for every card: one per gift would pile up in the session, card after card. #}
        data-favorite-token-value="{{ csrf_token('gift-favorite') }}"
        data-favorite-target="button"
        data-action="click->favorite#addFavorite">
        <twig:ux:icon
            class="size-5 text-accent {{ this.isFavorite ? '' : 'hidden' }}"
            name="rivet-icons:heart-solid"
            data-favorite-target="favoriteIcon" />
        <twig:ux:icon
            class="size-5 {{ this.isFavorite ? 'hidden' }}"
            name="rivet-icons:heart"
            data-favorite-target="notFavoriteIcon" />
    </button>
{% endif %}
