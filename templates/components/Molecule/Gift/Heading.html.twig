<div {{ attributes.defaults({ class: 'mt-3' }) }}>
    <h2 class="text-base font-semibold leading-snug break-words md:text-lg">
        {{ gift.title|u.truncate(120, '...', false) }}
    </h2>

    <p class="mt-1 text-3xl font-bold tabular-nums text-accent-content md:text-4xl">
        {{ gift.price ? gift.price|format_currency('EUR') : 'Prix libre' }}
    </p>
</div>
