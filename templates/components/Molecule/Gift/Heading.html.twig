<div {{ attributes.defaults({ class: 'mt-3' }) }}>
    <h2 class="text-base leading-snug font-semibold wrap-anywhere md:text-lg">
        {{ gift.title|u.truncate(120, '...', false) }}
    </h2>

    <p class="mt-1 text-2xl font-bold tabular-nums md:text-3xl">
        {{ gift.price ? gift.price|format_currency('EUR') : 'Prix libre' }}
    </p>
</div>
