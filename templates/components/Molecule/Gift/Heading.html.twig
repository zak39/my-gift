<div {{ attributes.defaults({ class: 'mt-3' }) }}>
    {# RGAA 9.1: one level below the heading the card sits under. #}
    <h{{ headingLevel }} class="text-base leading-snug font-semibold wrap-anywhere md:text-lg">
        {{ gift.title|u.truncate(120, '...', false) }}
    </h{{ headingLevel }}>

    <p class="mt-1 text-2xl font-bold tabular-nums md:text-3xl">
        {{ gift.price|format_currency('EUR') }}
    </p>
</div>
