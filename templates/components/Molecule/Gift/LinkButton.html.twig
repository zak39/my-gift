{% set wrapper = iconOnly
    ? { class: 'inline-block', 'data-controller': 'tooltip', 'data-tooltip-text-value': 'Aller sur la boutique' }
    : { class: 'contents' } %}

<div {{ attributes.defaults(wrapper) }}>
    <twig:Atomic:ButtonLink
        :to="gift.link"
        :style="style"
        class="{{ iconOnly ? 'btn-circle' : '' }}"
        :color="color"
        newWindow>
        <twig:block name="icon">
            <twig:ux:icon name="akar-icons:link-out" />
        </twig:block>
        <twig:block name="name">
            <span class="{{ iconOnly ? 'sr-only' : '' }}">Aller sur la boutique</span>
        </twig:block>
    </twig:Atomic:ButtonLink>
</div>
