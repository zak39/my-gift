<div {{ attributes.defaults({ class: 'w-full' }) }}>
    <article class="card card-sm sm:card-side bg-base-100 border border-base-300 shadow-sm transition-shadow duration-200 hover:shadow-md">
        <twig:Organism:Gift:Thumbnail
            :gift="gift"
            class="bg-base-200 sm:w-40 sm:shrink-0 md:w-48"
            imageClass="h-40 w-full object-cover sm:h-full" />

        <div class="card-body gap-0">
            <twig:Molecule:Gift:Badges :gift="gift" />
            <twig:Molecule:Gift:Heading :gift="gift" :headingLevel="headingLevel" />
            <twig:Molecule:Gift:Participants :gift="gift" />

            <div class="mt-auto flex flex-col gap-2 pt-4 sm:flex-row sm:flex-wrap sm:items-center">
                <twig:Molecule:Gift:StatusButtons :gift="gift" />
                <twig:Molecule:Gift:ShowButton :gift="gift" style="outline" />
            </div>
        </div>
    </article>
</div>
