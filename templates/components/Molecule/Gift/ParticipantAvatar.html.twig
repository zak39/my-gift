<div{{ attributes }}>
    {% if participant.isAnonymous %}
        <div class="avatar avatar-placeholder {{ size }}">
            <div class="bg-secondary text-secondary-content w-24 rounded-full">
                <span class="text-3xl">{{ participant.pseudoAnonyme|u.truncate(2)|capitalize }}</span>
            </div>
        </div>
    {% elseif participant.isFromDeletedUser %}
        <div class="avatar avatar-placeholder {{ size }}">
            <div class="bg-base-300 text-muted w-24 rounded-full">
                <twig:ux:icon name="lucide:user-x" class="size-1/2" aria-label="{{ participant.displayName }}" />
            </div>
        </div>
    {% else %}
        <twig:Molecule:UserAvatar :user="participant.participantUser" :sizeClass="size" />
    {% endif %}
</div>