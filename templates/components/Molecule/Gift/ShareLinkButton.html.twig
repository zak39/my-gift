{% set wrapper = iconOnly
    ? { class: 'tooltip', 'data-tip': 'Copier le lien du cadeau' }
    : { class: 'contents' } %}

<div {{ attributes.defaults(wrapper) }}>
    <twig:atomic:Button :style="style"
        class="{{ iconOnly ? 'btn-circle' : '' }}"
        data-controller="copy"
        data-copy-text-value="{{ absolute_url(gift_viewer_show_url(gift)) }}"
        data-action="click->copy#copy"
        :color="color">
        <twig:block name="icon">
            <span data-copy-target="icon">
                <twig:ux:icon name="lucide:share" />
            </span>
        </twig:block>
        <twig:block name="name">
            <span class="{{ iconOnly ? 'sr-only' : '' }}" data-copy-target="label">Partager</span>
        </twig:block>
    </twig:atomic:Button>
</div>
