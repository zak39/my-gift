<div{{ attributes }} class="contents">
    <twig:atomic:Button :style="style"
        data-controller="copy"
        data-copy-text-value="{{ absolute_url(path('app_gift_show', { 'id': gift.id })) }}"
        data-action="click->copy#copy"
        :color="color">
        <twig:block name="icon">
            <span data-copy-target="icon">
                <twig:ux:icon name="lucide:share" />
            </span>
        </twig:block>
        <twig:block name="name">
            <span class="{{ hideLabelOnMobile ? 'md:block hidden' : '' }}" data-copy-target="label">Partager</span>
        </twig:block>
    </twig:atomic:Button>
</div>
