<div{{ attributes }} class="contents">
    <twig:atomic:ButtonLink
        :style="style"
        :to="path('app_gift_show', { id: gift.id })"
        :color="color">
        <twig:block name="icon">
            <twig:ux:icon name="fluent:eye-12-filled" />
        </twig:block>
        <twig:block name="name">
            <span class="{{ hideLabelOnMobile ? 'md:block hidden' : '' }}">Voir</span>
        </twig:block>
    </twig:atomic:ButtonLink>
</div>
