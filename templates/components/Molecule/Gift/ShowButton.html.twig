{# Shared by the owners' pages and the givers' ones, so it is the one place that picks the
   URL: an owner opens their own page of the gift, anyone else /gift/{id}/show. #}
<div {{ attributes.defaults({ class: 'contents' }) }}>
    <twig:Atomic:ButtonLink
        :style="style"
        :to="is_granted('gift.is_owner', gift)
            ? gift_owner_show_url(gift)
            : gift_viewer_show_url(gift)"
        :color="color">
        <twig:block name="icon">
            <twig:ux:icon name="fluent:eye-12-filled" />
        </twig:block>
        <twig:block name="name">
            <span>Voir</span>
        </twig:block>
    </twig:Atomic:ButtonLink>
</div>
