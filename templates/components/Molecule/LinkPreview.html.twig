{# Messengers want absolute URLs: LinkPreviewBuilder gives them. #}
<meta property="og:site_name" content="My Gift">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ preview.title }}">
<meta property="og:description" content="{{ preview.description }}">
<meta property="og:url" content="{{ preview.url }}">
<meta property="og:image" content="{{ preview.image.url }}">
<meta property="og:image:alt" content="{{ preview.image.alt }}">
{% if preview.image.type %}
    <meta property="og:image:type" content="{{ preview.image.type }}">
{% endif %}
{% if preview.image.width and preview.image.height %}
    <meta property="og:image:width" content="{{ preview.image.width }}">
    <meta property="og:image:height" content="{{ preview.image.height }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
