<div {{ attributes.defaults({ class: 'dropdown dropdown-end md:flex hidden', 'data-controller': 'dropdown' }) }}>
    {# The dot tells from any page that crew invitations wait in the menu, without opening it. The
       friend requests show on « Mes ami·es », in the navbar itself (Molecule:Navbar:Links). #}
    <div tabindex="0" role="button" class="indicator btn btn-ghost btn-circle avatar" data-dropdown-target="trigger">
        {% if computed.pendingCrewInvitationCount > 0 %}
            <span class="indicator-item badge badge-secondary badge-xs" aria-hidden="true"></span>
        {% endif %}
        <twig:Molecule:UserAvatar :user="app.user" id="user_avatar_header" />
    </div>
    <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-box z-1 mt-3 w-52 p-2 shadow">
            <li><twig:Atomic:Router:Link link="{{ path('app_user_profile') }}" name="Profil" /></li>
            <li><twig:Atomic:Router:Link link="{{ path('app_dashboard') }}" name="Mon Dashboard" /></li>
            <li><twig:Atomic:Router:Link link="{{ path('app_section') }}" name="Mes Cadeaux" /></li>
            <li><twig:Atomic:Router:Link link="{{ path('app_gift_user_favorites') }}" name="Mes Favoris" /></li>
            <li>
                <a href="{{ path('app_crew') }}">
                    Mes groupes
                    {% if computed.pendingCrewInvitationCount > 0 %}
                        <span class="badge badge-sm badge-secondary">
                            {{ computed.pendingCrewInvitationCount }}
                            <span class="sr-only">invitation{{ computed.pendingCrewInvitationCount > 1 ? 's' }} reçue{{ computed.pendingCrewInvitationCount > 1 ? 's' }}</span>
                        </span>
                    {% endif %}
                </a>
            </li>
            <li><button type="button" data-controller="dialog" data-dialog-id-value="modal_about" data-action="dialog#open">À propos</button></li>
            <li><twig:Atomic:Router:Link link="{{ path('app_logout') }}" name="Se déconnecter" /></li>
    </ul>
</div>
