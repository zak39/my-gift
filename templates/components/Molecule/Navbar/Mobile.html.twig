<div  {{ attributes }} class="drawer drawer-end md:hidden justify-end">
  <input id="my-drawer-5" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Page content here -->
    <label for="my-drawer-5" class="drawer-button btn btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /> </svg>
    </label>
  </div>
  <div class="drawer-side">
    <label for="my-drawer-5" aria-label="close sidebar" class="drawer-overlay"></label>

    <div class="menu bg-base-200 min-h-full w-80 p-4">
        <!-- Sidebar content here -->
        <div class="flex gap-4 items-center mb-6">
            <twig:Molecule:UserAvatar :user="app.user" sizeClass="w-16" id="user_avatar_header" />
            <span class="text-2xl">
                {{ app.user.firstname|capitalize }} {{ app.user.lastname|capitalize }}
            </span>
        </div>
        <ul>
            <li><twig:atomic:Router:Link link="{{ path('app_user_profile') }}" name="Profil" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_dashboard') }}" name="Mon Dashboard" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_section') }}" name="Mes sections" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_gift_user_favorites') }}" name="Mes Favoris" /></li>
            <li>
                <a href="{{ path('app_friend') }}">
                    Mes ami·es
                    {% if computed.pendingFriendRequestCount > 0 %}
                        <span class="badge badge-sm badge-secondary">
                            {{ computed.pendingFriendRequestCount }}
                            <span class="sr-only">demande{{ computed.pendingFriendRequestCount > 1 ? 's' }} reçue{{ computed.pendingFriendRequestCount > 1 ? 's' }}</span>
                        </span>
                    {% endif %}
                </a>
            </li>
            <li>
                <a href="{{ path('app_crew') }}">
                    Mes groupes
                    {% if computed.pendingCrewInvitationCount > 0 %}
                        <span class="badge badge-sm badge-secondary">
                            {{ computed.pendingCrewInvitationCount }}
                            <span class="sr-only">invitation{{ computed.pendingCrewInvitationCount > 1 ? 's' }} reçue{{ computed.pendingCrewInvitationCount > 1 ? 's' }}</span>
                        </span>
                    {% endif %}
                </a>
            </li>
            <li><button type="button" data-controller="dialog" data-dialog-id-value="modal_about" data-action="dialog#open">À propos</button></li>
            <li><twig:atomic:Router:Link link="{{ path('app_logout') }}" name="Se déconnecter" /></li>
        </ul>

        <div class="divider"></div>

        <ul class="menu menu-vertical px-1">
            <twig:molecule:Router:RouterList />
        </ul>
    </div>
  </div>
</div>
