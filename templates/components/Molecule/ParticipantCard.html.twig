<li {{ attributes.defaults({ class: 'list-row items-center' }) }}>
    <twig:Molecule:Gift:ParticipantAvatar :participant="participant" :size="avatarSize" />
    <span class="font-medium">{{ this.displayName }}</span>
    {% if showAmount %}
        <span class="font-semibold tabular-nums">
            {{ participant.amount|format_currency('EUR') }}
        </span>
    {% endif %}
</li>
