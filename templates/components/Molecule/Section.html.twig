<section {{ attributes.defaults({ class: 'relative scroll-mt-6 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm' }
    |merge(anchor ? {id: anchor, 'data-controller': 'section-anchor'} : {})) }}>
    {# Ribbon on the edge of the section, echoing the gift wrap of the list header. #}
    <span aria-hidden="true" class="absolute inset-y-0 start-0 w-1.5 bg-primary"></span>

    {# RGAA 10.7: daisyUI draws the focus ring of the toggle 2px outside .collapse, which the
       card's overflow-hidden clips. Pulled inside instead (-outline-offset-2), over the ribbon.
       The variant repeats daisyUI's own focus selector: after a daisyUI upgrade, tab onto a
       section again to check the ring is still drawn, and keeps 3:1 on the ribbon (RGAA 3.3). #}
    <div class="collapse collapse-arrow has-[>input:focus-visible]:-outline-offset-2">
        {# RGAA 7.1: the toggle names what it shows without calling it a section, which a block of
           /me/participations (« En cours », « Offerts »…) is not. Read by screen readers only. #}
        <input type="checkbox"
            {% if anchor %}data-section-anchor-target="toggle"{% endif %}
            {{ checked ? 'checked' : '' }}
            aria-label="Afficher ou masquer les cadeaux : {{ title }}" />

        <div class="collapse-title ps-6">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                {# Decorative: the title names the section (ux:icon sets aria-hidden). #}
                {% if icon %}
                    <twig:ux:icon :name="icon" class="size-5 shrink-0" />
                {% endif %}
                <h{{ headingLevel }} class="min-w-0 text-base font-semibold wrap-anywhere sm:text-lg">{{ title }}</h{{ headingLevel }}>
                {% if giftCount is not null %}
                    <span class="badge badge-sm badge-ghost tabular-nums">
                        {{ giftCount }} cadeau{{ giftCount > 1 ? 'x' }}
                    </span>
                {% endif %}
            </div>
            {% if description %}
                <p class="mt-1 text-sm text-muted wrap-anywhere">{{ description }}</p>
            {% endif %}
        </div>

        <div class="collapse-content ps-6">
            <div class="flex flex-col gap-4">
                <div class="flex flex-wrap justify-end gap-1 empty:hidden">
                    {% block actionButtons %}
                    {% endblock %}
                </div>
                {% block gifts %}
                {% endblock %}
            </div>
        </div>
    </div>
</section>
