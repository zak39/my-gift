<nav {{ attributes.defaults({ class: 'min-w-0' }) }} aria-label="Sections de la liste">
    <ul class="menu menu-horizontal w-full flex-nowrap overflow-x-auto rounded-box border border-base-300 bg-base-100 lg:menu-vertical lg:flex-wrap lg:overflow-visible">
        <li class="menu-title hidden lg:block">Sections</li>

        {% for section in sections %}
            <li>
                <a href="#section-{{ section.id }}"
                    class="whitespace-nowrap lg:whitespace-normal"
                    onclick="document.getElementById('section-{{ section.id }}-toggle').checked = true">
                    <twig:ux:icon name="lucide:tag" class="size-4 shrink-0" />
                    <span class="min-w-0 lg:wrap-anywhere">{{ section.title }}</span>
                    <span class="badge badge-sm badge-ghost tabular-nums">{{ this.giftCount(section.gifts) }}</span>
                </a>
            </li>
        {% endfor %}

        {% if this.hasGiftsWithoutSection %}
            <li>
                <a href="#section-sans-section"
                    class="whitespace-nowrap lg:whitespace-normal"
                    onclick="document.getElementById('section-sans-section-toggle').checked = true">
                    <twig:ux:icon name="lucide:package-open" class="size-4 shrink-0" />
                    <span class="min-w-0 lg:wrap-anywhere">Cadeaux sans section</span>
                    <span class="badge badge-sm badge-ghost tabular-nums">{{ this.giftCount(giftsWithoutSection) }}</span>
                </a>
            </li>
        {% endif %}

        {# Anchors to the cards of Organism:Crew:SharedLists, below the sections. #}
        {% if crews is not empty %}
            <li class="menu-title hidden lg:mt-2 lg:block">Groupes</li>

            {% for crew in crews %}
                <li>
                    <a href="#crew-{{ crew.id }}" class="whitespace-nowrap lg:whitespace-normal">
                        <twig:ux:icon name="lucide:users" class="size-4 shrink-0" />
                        <span class="min-w-0 lg:wrap-anywhere">{{ crew.name }}</span>
                        <span class="badge badge-sm badge-ghost tabular-nums">{{ crew.giftCount }}</span>
                    </a>
                </li>
            {% endfor %}
        {% endif %}
    </ul>
</nav>
