{# Buy Me a Coffee's own button script writes itself with document.writeln(), which a Turbo
   visit ignores: the same button, as a plain link. #}
{# style="": the brand's own yellow, no daisyUI variant. Only the class goes through: any other
   attribute could be taken for one of ButtonLink's props (style, to…). #}
<twig:Atomic:ButtonLink :to="site.support_url" style="" newWindow
   {{ ...attributes.only('class').defaults({ class: 'border-none bg-[#FFDD00] text-black hover:bg-[#FFDD00]/80' }) }}>
    <twig:block name="icon"><span aria-hidden="true">🍵</span></twig:block>
    <twig:block name="name"><span lang="en">Buy me a matcha</span></twig:block>
</twig:Atomic:ButtonLink>
