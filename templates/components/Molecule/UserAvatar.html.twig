<twig:Molecule:Avatar {{ ...frameAttributes }}>
    <twig:block name="image">
        {% if imageAttributes.source is defined %}
            <twig:Atomic:Image {{ ...imageAttributes }} />
        {% else %}
            <twig:Molecule:User:AvatarPlaceholder {{ ...imageAttributes }} />
        {% endif %}
    </twig:block>
</twig:Molecule:Avatar>
