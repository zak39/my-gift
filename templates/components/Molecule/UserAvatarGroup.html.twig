{# overflow-visible: daisyUI clips the group, and the focus ring of the "+N" button has to stick out of it. #}
<div {{ attributes.defaults({ class: 'avatar-group -space-x-4 overflow-visible' }) }}>
    {% for user in users|slice(0, max) %}
        {# The pseudo on hover (tooltip controller: inside the viewport, closed by Escape, RGAA 10.11
           and 10.13). Screen readers already read it in the image's alt (RGAA 1.1), and the
           controller hides its tooltip from them, or they would hear it twice. #}
        <div class="flex" data-controller="tooltip" data-tooltip-text-value="{{ user.pseudo }}">
            <twig:Molecule:UserAvatar :user="user" :sizeClass="sizeClass" />
        </div>
    {% endfor %}

    {% set hiddenUsers = users|slice(max) %}
    {% if hiddenUsers is not empty %}
        {# The "+N" is a button so that the keyboard reaches it too: the tooltip shows when it has
           the focus (RGAA 10.13 / 7.1). It lists the pseudos, one per line; the button's name
           says the same for screen readers. #}
        {% set limit = 6 %}
        {% set truncated = hiddenUsers|length > limit %}
        {% set listed = hiddenUsers|slice(0, limit)|map(user => user.pseudo) %}
        <div class="flex" data-controller="tooltip"
            data-tooltip-text-value="{{ (truncated ? listed|merge(['…']) : listed)|join("\n") }}">
            <button type="button" class="avatar avatar-placeholder cursor-default"
                aria-label="Et {{ hiddenUsers|length }} autre{{ hiddenUsers|length > 1 ? 's' }} : {{ listed|join(', ') }}{{ truncated ? '…' }}">
                <div class="{{ sizeClass }} bg-neutral text-neutral-content">
                    <span class="text-sm" aria-hidden="true">+{{ hiddenUsers|length }}</span>
                </div>
            </button>
        </div>
    {% endif %}
</div>
