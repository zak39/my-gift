{# Same surface as CardGift, so a friend's card reads as part of the gift-list family. #}
<article {{ attributes.defaults({ class: 'card h-full border border-base-300 bg-base-100 shadow-sm transition-shadow duration-200 hover:shadow-md' }) }}>
    <div class="card-body gap-4 p-5">
        <div class="flex items-center gap-4">
            <twig:Molecule:UserAvatar
                :user="user"
                sizeClass="h-14 w-14 shrink-0 rounded-full ring-2 ring-base-300 ring-offset-2 ring-offset-base-100" />
            {# The title reads the pseudo that line-clamp may cut. #}
            <h2 class="card-title min-w-0 flex-col items-start gap-0" title="{{ user.pseudo }}">
                <twig:Molecule:User:Name :user="user" class="line-clamp-2" />
            </h2>
        </div>

        {# "Voir son profil" stays for everyone: for a non-friend, it leads to the private list page.
           The friendship buttons drop their own row (contents) to share this one, so their "…"
           can wrap below all of them. #}
        <div class="card-actions mt-auto items-center justify-end">
            <twig:Molecule:Friend:ActionButtons class="contents!" :user="user" />
            <twig:Atomic:ButtonLink
                class="btn-sm"
                style="ghost"
                :to="path('app_section_user_page', { id: user.id })">
                <twig:block name="name">
                    <span>Voir son profil</span>
                </twig:block>
                <twig:block name="icon">
                    <twig:ux:icon name="lucide:arrow-right" class="size-4" />
                </twig:block>
            </twig:Atomic:ButtonLink>
        </div>
    </div>
</article>
