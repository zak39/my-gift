<div{{ attributes }} class="contents">
    <twig:Molecule:Gift:StatusButtons :gift="gift" />
    <twig:Molecule:Gift:ShareLinkButton :gift="gift" />
    {% if gift.link %}
        <twig:Molecule:Gift:LinkButton :gift="gift" />
    {% endif %}
    {% if is_granted('gift.is_creator', gift) %}
        <twig:Molecule:Gift:EditButton :gift="gift" />
        <twig:Molecule:Gift:DeleteButton :gift="gift" />
    {% endif %}
</div>
