{% if computed.showWho %}
    <section {{ attributes.defaults({ class: 'flex flex-col gap-3' }) }} aria-labelledby="gift-contributors-title">
        <h2 id="gift-contributors-title" class="flex items-center gap-2 text-lg font-semibold">
            <twig:ux:icon name="lucide:heart-handshake" class="size-5" />
            Offert par
            {% if computed.pooled %}
                <span class="badge badge-ghost badge-sm tabular-nums">{{ gift.participants|length }}</span>
            {% endif %}
        </h2>

        <ul class="list rounded-box border border-base-300">
            {% for participant in gift.participants %}
                <twig:molecule:ParticipantCard :participant="participant"
                    :showAmount="computed.pooled and computed.showAmounts" />
            {% endfor %}
        </ul>
    </section>
{% elseif computed.isCreator %}
    <div {{ attributes.defaults({ class: 'alert alert-soft' }) }} role="status">
        <twig:ux:icon name="{{ computed.waitingOnPool ? 'lucide:piggy-bank' : 'lucide:hourglass' }}" class="size-5" />
        <span>
            {% if computed.waitingOnPool %}
                Une cagnotte est en cours pour ce cadeau. Vous découvrirez qui y a participé une fois qu'elle sera complète.
            {% else %}
                Personne ne vous a offert ce cadeau pour le moment.
            {% endif %}
        </span>
    </div>
{% endif %}
