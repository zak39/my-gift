{% if gift.participants|length > 1 or gift.status.value == 'contributing' %} 
  {% set percent = (gift.totalContributed * 100) / gift.price %}
{% endif %}

<div{{ attributes }} class="contents">
    {% if gift.participants|length > 0 %}
        <h2 class="card-title w-full text-xl">Offert par</h2>
        <div class="flex flex-col-reverse gap-16 items-center w-full">
            <div class="flex flex-col gap-2 w-full items-center">
                {% if gift.participants|length > 1 or gift.status.value == 'contributing' %}
                    <div class="flex flex-col justify-center items-center gap-8 mb-6">
                        <twig:molecule:GiftContributingProgress percent="{{ percent|round }}" color="success" />
                        <div class="flex md:flex-row flex-col gap-4">
                            <twig:molecule:GiftMeta label="Total" value="{{ gift.totalContributed|format_currency('EUR')}} " />
                            <twig:molecule:GiftMeta label="Reste" value="{{ gift.remainingAmount|format_currency('EUR') }}" />
                        </div>
                    </div>
                    {% for participant in gift.participants %}
                        <twig:molecule:ParticipantCard :participant="participant" :showAmount="true" />
                    {% endfor %}
                {% else %}
                    <div class="card card-border md:card-md card-lg base-100 shadow-sm md:w-xs">
                        <twig:molecule:ParticipantCard :participant="gift.participants[0]" />
                    </div>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="card-title w-full">
            <h6 class="text-sm">Personne ne vous a offert le cadeau pour le moment.</h6>
        </div>
    {% endif %}
</div>
