{% set members = crew.members %}
{% set giftCount = this.giftCount %}

<section {{ attributes.defaults({ class: 'relative overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm' }) }}>
    <twig:atomic:GiftRibbon />

    <div class="flex flex-col gap-5 p-5 sm:p-7 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
        <div class="flex min-w-0 flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
            <twig:Molecule:UserAvatarGroup class="shrink-0" :users="members" :max="4" sizeClass="w-14 sm:w-16" />

            <div class="min-w-0">
                <h1 class="text-2xl leading-tight font-bold wrap-anywhere sm:text-3xl">{{ crew.name }}</h1>
                <p class="mt-2 flex items-center gap-2 text-sm text-base-content/70">
                    <twig:ux:icon name="lucide:users" class="size-4 shrink-0" />
                    <span>Sections communes de {{ members|map(member => member.firstname)|join(', ', ' et ') }}</span>
                </p>
                {% if giftCount > 0 %}
                    <p class="mt-1 flex items-center gap-2 text-sm text-base-content/70">
                        <twig:ux:icon name="lucide:gift" class="size-4 shrink-0" />
                        <span class="tabular-nums">{{ giftCount }} cadeau{{ giftCount > 1 ? 'x' }}</span>
                    </p>
                {% endif %}
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 lg:shrink-0 lg:justify-end">
            {% if ownerView %}
                <a href="{{ path('app_crew_section_new', { id: crew.id }) }}" class="btn btn-primary">
                    <twig:ux:icon name="lucide:folder-plus" class="size-4" />
                    Créer une section
                </a>
                <a href="{{ path('app_crew_edit', { id: crew.id }) }}" class="btn btn-outline btn-neutral">
                    <twig:ux:icon name="lucide:pencil" class="size-4" />
                    Renommer
                </a>
            {% endif %}
            {# The members and their friends alike: one page for both, one link. #}
            <twig:Molecule:ShareLinkButton :url="crew_share_url(crew)" label="Partager le groupe" color="neutral" />
            {% if is_granted('crew.can_leave', crew) %}
                <twig:Molecule:Crew:LeaveButton :crew="crew" />
            {% endif %}
            {% if is_granted('crew.can_delete', crew) %}
                <twig:Molecule:Crew:DeleteButton :crew="crew" />
            {% endif %}
        </div>
    </div>
</section>
