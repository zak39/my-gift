<div{{ attributes }} class="tabs tabs-box">
    <input type="radio" name="dashboard_tabs" class="tab" aria-label="Mes derniers cadeaux créés ({{ myGifts|length }})" checked="checked" />
    <twig:Molecule:Dashboard:GiftTabPanel
        :gifts="myGifts"
        emptyMessage="Vous n'avez pas encore ajouté de cadeau."
        seeAllRoute="{{ path('app_section') }}"
        emptyActionLabel="Commencer ma liste de cadeaux"
    />

    <input type="radio" name="dashboard_tabs" class="tab" aria-label="Mes derniers cadeaux en favoris ({{ myFavoritesGifts|length }})" />
    <twig:Molecule:Dashboard:GiftTabPanel
        :gifts="myFavoritesGifts"
        emptyMessage="Aucun favori pour le moment."
        seeAllRoute="{{ path('app_gift_user_favorites') }}"
    />

    <input type="radio" name="dashboard_tabs" class="tab" aria-label="Mes cadeaux réservés en cours ({{ myLastReservedParticipationGifts|length }})" />
    <twig:Molecule:Dashboard:GiftTabPanel
        :gifts="myLastReservedParticipationGifts"
        emptyMessage="Aucun cadeau réservé."
    />

    <input type="radio" name="dashboard_tabs" class="tab" aria-label="Mes participations à des cadeaux en cours ({{ myLastParticipatingParticipationGifts|length }})" />
    <twig:Molecule:Dashboard:GiftTabPanel
        :gifts="myLastParticipatingParticipationGifts"
        emptyMessage="Aucune participation à un cadeau."
    />
</div>