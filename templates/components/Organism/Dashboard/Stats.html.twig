<div{{ attributes }} class="stats stats-vertical sm:stats-horizontal shadow bg-base-100 w-full">
    <div class="stat place-items-center">
        <div class="stat-title">Mes cadeaux</div>
        <div class="stat-value text-primary">{{ giftsCount }}</div>
    </div>
    <div class="stat place-items-center">
        <div class="stat-title">Mes participations en cours</div>
        <div class="stat-value text-secondary">{{ participatingGiftsCount }}</div>
    </div>
    <div class="stat place-items-center">
        <div class="stat-title">Mes réservations en cours</div>
        <div class="stat-value">{{ reservedParticipationGiftsCount }}</div>
    </div>
</div>