<section {{ attributes.defaults({ class: 'overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm' }) }}>
    {# Same ribbon as Organism:GiftListHeader: these pages are where a list gets filled. #}
    <twig:Atomic:GiftRibbon />

    <header class="flex items-start gap-4 p-5 sm:p-7">
        <span class="grid size-12 shrink-0 place-items-center rounded-box bg-base-200" aria-hidden="true">
            <twig:ux:icon :name="icon" class="size-6 opacity-80" />
        </span>

        <div class="flex min-w-0 flex-col gap-2">
            <h1 class="text-2xl leading-tight font-bold wrap-break-word sm:text-3xl">{{ title }}</h1>
            {% if description %}
                <p class="max-w-prose text-sm text-base-content/70">{{ description }}</p>
            {% endif %}
            {% block meta %}{% endblock %}
        </div>
    </header>

    {% block content %}{% endblock %}
</section>
