<div{{ attributes }} class="flex flex-col gap-2 w-full">
    <figure class="px-10 pt-10">
    <img
        class="size-96 object-cover rounded-xl"
        src={{ gift.image ? vich_uploader_asset(gift, 'imageFile') : "https://img.daisyui.com/images/stock/photo-1494232410401-ad00d5433cfa.webp" }}
        alt={{ gift.title }} />
    </figure>

    <div class="card-body">
    <h2 class="card-title text-2xl">
        {{ gift.title }}
    </h2>
    <p class="md:text-base text-lg md:text-md">
        {{ gift.description }}
    </p>
    <div class="flex flex-col md:flex-row md:gap-2 gap-4 my-6">
        <twig:molecule:GiftMeta label="Créé le" value="{{ gift.createdAt|format_datetime('medium', 'none', locale: 'fr') }}" badgeValueType="soft" />
        <twig:molecule:GiftMeta label="Mis à jour" value="{{ gift.updateAt|format_datetime('medium', 'none', locale: 'fr') }}" badgeValueType="soft" />
        <twig:molecule:GiftMeta label="Prix" value="{{ gift.price|format_currency('EUR', { padding_position: 'before_suffix' }) }}" badgeValueType="soft" />
        {% if gift.isPublic %}
        <twig:molecule:GiftMeta label="Public" value="Oui" badgeValueColor="success" />
        {% else %}
        <twig:molecule:GiftMeta label="Public" value="Non" badgeValueColor="error" />
        {% endif %}
    </div>
    </div>
</div>