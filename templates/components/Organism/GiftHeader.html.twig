<header {{ attributes.defaults({ class: 'flex flex-col gap-4' }) }}>
    <div class="flex items-start justify-between gap-4">
        <twig:Molecule:Gift:Badges :gift="gift" />
        <twig:Molecule:Gift:FavoriteButton :gift="gift" class="-mt-1 -mr-2" />
    </div>

    <div>
        <h1 class="text-3xl leading-tight font-bold wrap-break-word md:text-4xl">
            {{ gift.title }}
        </h1>
        <p class="mt-2 text-2xl font-semibold tabular-nums text-base-content/80">
            {{ gift.price|format_currency('EUR') }}
        </p>
    </div>

    {% if gift.description %}
        <p class="max-w-prose text-base leading-relaxed text-base-content/80">
            {{ gift.description }}
        </p>
    {% endif %}

    <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-base-content/60">
        <span class="inline-flex items-center gap-1.5">
            <twig:ux:icon name="lucide:calendar-plus" class="size-4" />
            Ajouté le {{ gift.createdAt|format_datetime('medium', 'none', locale: 'fr') }}
        </span>
        {% if gift.updateAt %}
            <span class="inline-flex items-center gap-1.5">
                <twig:ux:icon name="lucide:pencil" class="size-4" />
                Modifié le {{ gift.updateAt|format_datetime('medium', 'none', locale: 'fr') }}
            </span>
        {% endif %}
    </p>
</header>
