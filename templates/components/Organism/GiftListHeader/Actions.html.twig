<div {{ attributes.defaults({ class: 'flex flex-wrap items-center gap-2 lg:shrink-0 lg:justify-end' }) }}>
    {% if ownerView %}
        <a href="{{ path('app_gift_create') }}" class="btn btn-primary">
            <twig:ux:icon name="lucide:plus" class="size-4" />
            Ajouter un cadeau
        </a>
        <a href="{{ path('app_section_new') }}" class="btn btn-outline">
            <twig:ux:icon name="lucide:folder-plus" class="size-4" />
            Créer une section
        </a>
        <a href="{{ path('app_section_user_page', { id: user.id }) }}" class="btn btn-ghost">
            <twig:ux:icon name="lucide:eye" class="size-4" />
            Voir mon profil public
        </a>
    {% else %}
        {# Distinct from ownerView: the owner previewing their own public profile is the
           owner, but is not in the management view. #}
        {% if is_granted('user.is_owner', user) %}
            <a href="{{ path('app_section_new') }}" class="btn btn-primary">
                <twig:ux:icon name="lucide:folder-plus" class="size-4" />
                Créer une section
            </a>
        {% endif %}
        <twig:Molecule:ShareLinkButton :url="user_list_share_url(user)" label="Partager le profil" />
    {% endif %}
</div>
