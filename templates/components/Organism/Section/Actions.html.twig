{# Shown on the user's own list and on a crew's: the URLs follow the section's list
   (SectionUrlGenerator, GiftOwnerUrlGenerator). Guarded as the routes are, so no button leads to a refusal. #}
{% if is_granted('section.is_owner', section) %}
    <twig:atomic:ButtonLink
        class="btn-sm"
        style="ghost"
        :to="gift_create_url(section)">
        <twig:block name="icon">
            <twig:ux:icon name="lucide:plus" class="size-4" />
        </twig:block>
        <twig:block name="name">
            <span>Ajouter un cadeau</span>
        </twig:block>
    </twig:atomic:ButtonLink>

    <twig:atomic:ButtonLink
        class="btn-sm"
        style="ghost"
        :to="section_edit_url(section)">
        <twig:block name="icon">
            <twig:ux:icon name="ic:baseline-edit" class="size-4" />
        </twig:block>
        <twig:block name="name">
            <span>Editer la section</span>
        </twig:block>
    </twig:atomic:ButtonLink>

    <twig:Modal :id="section.id"
        :title="section.title"
        class="remove_section">
        <twig:block name="handlerButton">
            <twig:atomic:Button
                class="btn-sm"
                style="ghost"
                onclick="modal_remove_section_{{ section.id }}.showModal()">
                <twig:block name="icon">
                    <twig:ux:icon name="heroicons:trash-16-solid" class="size-4" />
                </twig:block>
                <twig:block name="name">
                    <span>Supprimer la section</span>
                </twig:block>
            </twig:atomic:Button>
        </twig:block>
        <twig:block name="message">
            <p class="py-4">Est-ce que vous êtes sûr de supprimer la section <b>{{ section.title }}</b> ?</p>
            {% if section.crew %}
                <p class="py-4">Ses cadeaux quitteront les sections du groupe et retourneront dans les <b>Cadeaux sans section</b> de celles et ceux qui les ont ajoutés.</p>
                <twig:Molecule:Crew:OrphanGiftsWarning />
            {% else %}
                <p class="py-4">La suppression de la section ne supprimera pas les cadeaux. Ils seront déplacés dans la section <b>Cadeaux sans section</b>.</p>
            {% endif %}
        </twig:block>
        <twig:block name="actionButtons">
            <form method="post" action="{{ section_delete_url(section) }}">
                <input type="hidden" name="_method" value="DELETE">
                <input type="hidden" name="_token" value="{{ csrf_token('section-delete-' ~ section.id) }}">
                <button type="submit" class="btn btn-outline btn-secondary">
                    <twig:ux:icon name="heroicons:trash-16-solid" />
                    Supprimer
                </button>
            </form>
        </twig:block>
    </twig:Modal>
{% endif %}
