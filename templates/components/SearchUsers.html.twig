<div {{ attributes.defaults({ class: 'flex flex-col' }) }}>
    <div class="rounded-box border border-base-300 bg-base-100 p-4 shadow-sm sm:p-5">
        <label class="input w-full" data-controller="reset-searchbar">
            <twig:ux:icon name="lucide:search" class="size-4 shrink-0 opacity-50" />
            <span class="sr-only">Chercher un ami par son prénom ou son nom</span>
            <input type="search"
                class="grow"
                placeholder="Chercher un ami par son prénom ou son nom"
                data-reset-searchbar-target="field"
                data-model="debounce(300)|query" />
            <button type="button"
                class="btn btn-ghost btn-xs btn-circle"
                aria-label="Effacer la recherche"
                data-action="reset-searchbar#reset">
                <twig:ux:icon name="lucide:x" class="size-4" />
            </button>
        </label>

        {% set total = this.users.getTotalItemCount() %}
        {% if total > 0 %}
            <p class="mt-2 text-sm text-base-content/70">
                <span class="tabular-nums">
                    {{ total }}
                </span>
                {% if query is empty %}
                    utilisateur{{ total > 1 ? 's' : '' }}
                {% else %}
                    utilisateur{{ total > 1 ? 's' : '' }} trouvé{{ total > 1 ? 's' : '' }} pour « {{ query }} »
                {% endif %}
            </p>
        {% endif %}
    </div>

    {# The skeletons borrow the card geometry and sit in the same grid, so a search never
       collapses the layout. min-loading keeps them up for a minimum time: a local response
       is so fast that plain `data-loading` would only flash them for a frame. #}
    <div class="group mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3"
        data-controller="min-loading"
        data-min-loading-duration-value="500">
        <p class="sr-only hidden group-data-searching:block" role="status">Recherche d'amis en cours…</p>
        {% for i in 1..9 %}
            <div aria-hidden="true"
                class="hidden group-data-searching:flex flex-col gap-4 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
                <div class="flex items-center gap-4">
                    <div class="skeleton size-14 shrink-0 rounded-full"></div>
                    <div class="flex w-full flex-col gap-2">
                        <div class="skeleton h-4 w-3/4"></div>
                        <div class="skeleton h-4 w-1/2"></div>
                    </div>
                </div>
                <div class="skeleton h-8 w-32 self-end"></div>
            </div>
        {% endfor %}

        {% for user in this.users %}
            <twig:Molecule:UserCard :user="user" class="group-data-searching:hidden" />
        {% else %}
            <twig:Molecule:EmptyContentHero class="col-span-full rounded-box group-data-searching:hidden"
                title="Aucun utilisateur trouvé"
                description='Aucun utilisateur trouvé avec "{{ query }}" !' />
        {% endfor %}

        <div class="col-span-full flex justify-center group-data-searching:hidden">
            {{ knp_pagination_render(this.users, 'components/pagination.html.twig') }}
        </div>
    </div>
</div>
