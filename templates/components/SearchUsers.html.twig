<div{{ attributes }}>
    <div class="flex md:flex-row flex-col gap-4">
        <label class="input md:w-xl w-sm" data-controller="reset-searchbar">
            <svg class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <g
                stroke-linejoin="round"
                stroke-linecap="round"
                stroke-width="2.5"
                fill="none"
                stroke="currentColor"
                >
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
                </g>
            </svg>
            <input type="search"
                class="md:input-md input-lg"
                placeholder="Chercher un ami"
                data-reset-searchbar-target="field"
                data-model="debounce(300)|query" />
            <button class="btn btn-xs btn-circle" data-action="reset-searchbar#reset">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 16 16"><path fill="currentColor" d="M12.293 2.293a1 1 0 0 1 1.414 1.414L9.414 8l4.293 4.293a1 1 0 1 1-1.414 1.414L8 9.414l-4.293 4.293a1 1 0 1 1-1.414-1.414L6.586 8L2.293 3.707a1 1 0 1 1 1.414-1.414L8 6.586z"/></svg>
            </button>
        </label>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 justify-items-center gap-4 w-full my-8">
        <div data-loading="show" class="col-span-full text-center">
            <h1 class="skeleton skeleton-text text-xl">Recherche d'utilisateurs en cours...</h1>
        </div>
        {% for user in this.users %}
            <div data-loading="hide">
                <twig:molecule:UserCard :user="user" />
            </div>
        {% else %}
            <twig:molecule:EmptyContentHero class="col-span-full text-center"
                title="Aucun utilisateur trouvé"
                description='Aucun utilisateur trouvé avec "{{ query }}" !' />
        {% endfor %}

        <div data-loading="hide" class="col-span-full flex justify-center">
            {{ knp_pagination_render(this.users, 'components/pagination.html.twig') }}
        </div>
    </div>
</div>
