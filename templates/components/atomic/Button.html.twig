<div{{ attributes }}>
    {% if to == '#' %}
        <button type="button" class="btn btn-{{ type }} btn-{{ size }}">
            {% block icon %}{% endblock %}
            {{ name }}
        </button>
    {% else %}
        <a href="{{ path(to, parameters) }}" class="btn btn-{{ type }} btn-{{ size }}">
            {{ name }}
        </a>
    {% endif %}
</div>
