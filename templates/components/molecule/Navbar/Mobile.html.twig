<div  {{ attributes }} class="drawer drawer-end md:hidden justify-end">
  <input id="my-drawer-5" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content">
    <!-- Page content here -->
    <label for="my-drawer-5" class="drawer-button btn btn-circle">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /> </svg>
    </label>
  </div>
  <div class="drawer-side">
    <label for="my-drawer-5" aria-label="close sidebar" class="drawer-overlay"></label>

    <div class="menu bg-base-200 min-h-full w-80 p-4">
        <!-- Sidebar content here -->
        <div class="flex gap-4 items-center mb-6">
            <twig:molecule:Avatar class="w-16">
                <twig:block name="image">
                    <twig:atomic:Image id="user_avatar_header"
                        source="{{ app.user.avatar ? vich_uploader_asset(app.user, 'avatarFile') : vich_uploader_asset(app.user, 'avatarDefaultFile') }}"
                        alt="{{ 'Photo de profil ' ~ app.user.firstname ~ ' ' ~ app.user.lastname  }}" />
                </twig:block>
            </twig:molecule:Avatar>
            <span class="text-2xl">
                {{ app.user.firstname|capitalize }} {{ app.user.lastname|capitalize }}
            </span>
        </div>
        <ul>
            <li>
            <a class="justify-between" href={{ path('app_user_profile') }}>
                Profile
                <span class="badge">New</span>
            </a>
            </li>
            <li><twig:atomic:Router:Link link="{{ path('app_gift') }}" name="Mes cadeaux" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_section', {id: app.user.id }) }}" name="Mes listes" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_gift_user_favorites') }}" name="Mes Favoris" /></li>
            <li><twig:atomic:Router:Link name="Settings" /></li>
            <li><twig:atomic:Router:Link link="{{ path('app_logout') }}" name="Se déconnecter" /></li>
        </ul>

        <div class="divider"></div>

        <ul class="menu menu-vertical px-1">
            <twig:molecule:Router:RouterList />
        </ul>
    </div>
  </div>
</div>
