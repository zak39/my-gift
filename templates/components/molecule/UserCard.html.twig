<div{{ attributes }}>
  <div class="card card-border bg-base-100 md:w-80 w-96">
    <div class="card-body">
      <div class="flex gap-4">
          <twig:molecule:Avatar class="md:h-16 md:w-16 h-14 w-14">
              <twig:block name="image">
                  <twig:atomic:Image source="{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : vich_uploader_asset(user, 'avatarDefaultFile') }}"
                      alt="{{ 'Photo de profil ' ~ user.firstname ~ ' ' ~ user.lastname  }}" />
              </twig:block>
          </twig:molecule:Avatar>
          <h2 class="card-title">{{ user.firstname }} {{ user.lastname }}</h2>
      </div>
      <div class="card-actions justify-end">
        <twig:atomic:ButtonLink class="md:btn-sm btn-md"
          name="Voir profil"
          :to="path('app_section_user_page', { id: user.id })" />
      </div>
    </div>
  </div>
</div>
