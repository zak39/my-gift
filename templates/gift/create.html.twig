{% extends 'base.html.twig' %}

{% block title %}Créer son cadeau{% endblock %}

{% block body %}
<div class="hero min-h-screen flex items-center justify-center">
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-xs border p-4">
        <legend class="fieldset-legend">Créer son cadeau</legend>

        {{ form_start(form) }}
            <div class="my-4">
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
                {{ form_label(form.link) }}
                <label class="input">
                    <span class="label">https://</span>
                    {{ form_widget(form.link) }}
                </label>
                {{ form_row(form.image) }}
                {{ form_row(form.price) }}
                <div class="my-4">
                    {{ form_label(form.isPublic) }}
                    {{ form_widget(form.isPublic) }}
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-full">Créer un cadeau</button>
        {{ form_end(form) }}
    </fieldset>
</div>
{% endblock %}
