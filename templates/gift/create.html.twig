{% extends 'base.html.twig' %}

{% block title %}My Gift | Ajouter un cadeau{% endblock %}

{% block body %}
<div class="mx-auto w-full max-w-4xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Organism:Form:Card
        icon="lucide:gift"
        title="Ajouter un cadeau"
        description="Collez le lien du produit pour remplir la fiche automatiquement, ou complétez-la à la main.">
        <twig:Organism:Gift:Form :form="form" :initialFormData="gift" />
    </twig:Organism:Form:Card>
</div>
{% endblock %}
