{% extends 'base.html.twig' %}

{% block title %}My Gift | Modifier un cadeau{% endblock %}

{% block body %}
{% form_theme form 'form/daisyui_layout.html.twig' %}

<div class="mx-auto w-full max-w-4xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Organism:Form:Card
        icon="lucide:gift"
        title="Modifier le cadeau">
        <twig:block name="meta">
            <twig:Molecule:Gift:StatusBadge :gift="gift" class="self-start" />
        </twig:block>

        {{ form_start(form) }}
            {% if form.vars.errors|length > 0 %}
                <div class="border-t border-base-300 p-5 sm:px-7">{{ form_errors(form) }}</div>
            {% endif %}

            <twig:Molecule:Form:FieldGroup
                title="Le cadeau"
                description="Ce que vos amis verront en premier dans votre liste.">
                <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_11rem]">
                    {{ form_row(form.title) }}
                    {{ form_row(form.price) }}
                </div>
                {{ form_row(form.description) }}
            </twig:Molecule:Form:FieldGroup>

            <twig:Molecule:Form:FieldGroup
                title="Le lien"
                description="La page où vos amis pourront l'acheter.">
                {{ form_row(form.link) }}
            </twig:Molecule:Form:FieldGroup>

            <twig:Molecule:Form:FieldGroup
                title="L'image"
                description="Elle illustre le cadeau sur sa fiche et dans votre liste.">
                <twig:Molecule:Gift:ImageField
                    :field="form.imageFile"
                    :fallbackUrl="gift.image ? vich_uploader_asset(gift, 'imageFile') : ''"
                    fallbackCaption="Image actuelle."
                    help="Choisissez un fichier pour remplacer l'image actuelle. JPEG, PNG ou WebP, au format carré ou portrait." />
            </twig:Molecule:Form:FieldGroup>

            <twig:Molecule:Form:FieldGroup
                title="Rangement et visibilité"
                description="Où le cadeau apparaît dans votre liste, et qui peut le voir.">
                {{ form_row(form.section) }}
                {{ form_row(form.isPublic) }}
            </twig:Molecule:Form:FieldGroup>

            <twig:Molecule:Form:Actions
                :cancelUrl="path('app_gift_show', { id: gift.id })"
                submitLabel="Enregistrer les modifications" />
        {{ form_end(form) }}
    </twig:Organism:Form:Card>
</div>
{% endblock %}
