{% extends 'base.html.twig' %}

{% block title %}Hello GiftController!{% endblock %}

{% block body %}
<div class="my-4">
    <h1 class="text-2xl">Les cadeaux</h1>
    <button class="btn btn-xs btn-primary my-4">
        <a href={{ path('app_gift_create') }}>Créer un cadeau</a>
    </button>
    <div class="flex flex-col gap-4 my-4 items-center">
        {% for gift in gifts %}
            <div class="card card-xs lg:card-side bg-base-100 shadow-sm">
                <figure>
                <img
                    class="md:size-104 size-95 object-contain"
                    src="https://img.daisyui.com/images/stock/photo-1494232410401-ad00d5433cfa.webp"
                    alt="Album" />
                </figure>
                <div class="card-body ml-2">
                    <div class="flex justify-between items-center gap-3">
                        <h2 class="card-title">
                            <span class="md:text-xl text-lg">{{ gift.title }}</span>
                        </h2>
                        <button class="btn btn-circle btn-soft btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="size-[1.2em]"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>
                        </button>
                    </div>
                    <div>
                        <span class="badge badge-lg badge-accent">
                            {{ gift.price|format_currency('EUR') }}
                        </span>
                    </div>

                    <div class="md:w-3xl">
                        <p class="md:text-lg mt-4 text-base line-clamp-4">
                            {{ gift.description }}. Lorem ipsum dolor sit, amet consectetur adipisicing elit. Esse nulla cum quae repellat laudantium nesciunt excepturi obcaecati nisi natus earum, ipsum laborum, ipsa fuga libero neque modi repellendus dolorum iusto. Lorem ipsum dolor sit amet consectetur adipisicing elit. Ullam unde, praesentium quaerat, tenetur provident placeat veritatis eos cum quas eius perferendis, saepe molestias. Aspernatur enim qui esse ad. Non, voluptatum!
                        </p>
                        <div class="card-actions my-4">
                            <a 
                                href="#"
                                class="link link-primary text-lg">
                                {{ gift.link }}
                            </a>
                        </div>
                    </div>
                    <div class="card-actions justify-start mb-4">
                        <div class="badge badge-outline badge-accent">Video game</div>
                        <div class="badge badge-outline badge-accent">Funny</div>
                    </div>
                    <div class="card-actions justify-end">
                        <button class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v13m4-9l-4-4l-4 4m-4 6v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/></svg>
                            Share
                        </button>
                        <button class="btn btn-soft btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 512 512"><path fill="none" d="M200 144h40v-40a40 40 0 1 0-40 40m152-40a40 40 0 0 0-80 0v40h40a40 40 0 0 0 40-40"/><path fill="currentColor" d="M80 416a64 64 0 0 0 64 64h92a4 4 0 0 0 4-4V292a4 4 0 0 0-4-4H88a8 8 0 0 0-8 8Zm160-164V144h32v108a4 4 0 0 0 4 4h140a47.9 47.9 0 0 0 16-2.75A48.09 48.09 0 0 0 464 208v-16a48 48 0 0 0-48-48h-40.54a2 2 0 0 1-1.7-3A72 72 0 0 0 256 58.82A72 72 0 0 0 138.24 141a2 2 0 0 1-1.7 3H96a48 48 0 0 0-48 48v16a48.09 48.09 0 0 0 32 45.25A47.9 47.9 0 0 0 96 256h140a4 4 0 0 0 4-4m32-148a40 40 0 1 1 40 40h-40Zm-74.86-39.9A40 40 0 0 1 240 104v40h-40a40 40 0 0 1-2.86-79.89ZM276 480h92a64 64 0 0 0 64-64V296a8 8 0 0 0-8-8H276a4 4 0 0 0-4 4v184a4 4 0 0 0 4 4"/></svg>
                            Give
                        </button>
                        <button class="btn btn-soft btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M9.335 11.502h2.17a4.5 4.5 0 0 1 4.5 4.5H9.004v1h8v-1a5.6 5.6 0 0 0-.885-3h2.886a5 5 0 0 1 4.516 2.852c-2.365 3.12-6.194 5.149-10.516 5.149c-2.761 0-5.1-.59-7-1.625v-9.304a6.97 6.97 0 0 1 3.33 1.428m-4.33 7.5a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-9a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1zm13-14a3 3 0 1 1 0 6a3 3 0 0 1 0-6m-7-3a3 3 0 1 1 0 6a3 3 0 0 1 0-6"/></svg>
                            Participate
                        </button>
                        <button class="btn btn-outline btn-secondary" onclick="my_modal_1.showModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 12 12"><path fill="currentColor" d="M1.974 6.659a.5.5 0 0 1-.948-.317c-.01.03 0-.001 0-.001a2 2 0 0 1 .062-.162c.04-.095.099-.226.18-.381c.165-.31.422-.723.801-1.136C2.834 3.827 4.087 3 6 3s3.166.827 3.931 1.662a5.5 5.5 0 0 1 .98 1.517l.046.113c.003.008.013.06.023.11L11 6.5s.084.333-.342.474a.5.5 0 0 1-.632-.314v-.003l-.006-.016l-.031-.078a4.5 4.5 0 0 0-.795-1.226C8.584 4.674 7.587 4 6 4s-2.584.673-3.194 1.338a4.5 4.5 0 0 0-.795 1.225l-.03.078zM4 7a2 2 0 1 1 4 0a2 2 0 0 1-4 0"/></svg>
                            See
                        </button>
                        <button class="btn btn-outline btn-secondary" onclick="my_modal_2.showModal()">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75zM20.71 7.04a.996.996 0 0 0 0-1.41l-2.34-2.34a.996.996 0 0 0-1.41 0l-1.83 1.83l3.75 3.75z"/></svg>
                            Edit
                        </button>
                        <button class="btn btn-outline btn-secondary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="currentColor" d="M7 21q-.825 0-1.412-.587T5 19V6H4V4h5V3h6v1h5v2h-1v13q0 .825-.587 1.413T17 21zm2-4h2V8H9zm4 0h2V8h-2z"/></svg>
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
