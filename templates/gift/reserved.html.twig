{% extends 'base.html.twig' %}

{% block title %}My Gift | Réserver le cadeau {{ gift.title }}{% endblock %}

{% block body %}
<div class="flex justify-center my-16">
    <div class="flex flex-col items-center md:w-4xl w-full">
        <div class="card bg-base-100 w-full">
            <div class="card-body">
                <div class="card-title">
                    <h1>Réserver un cadeau</h1>
                </div>
                {{ form_start(form, { "attr": { "class": "w-full", "enctype": "multipart/form-data" } }) }}
                    <div class="flex flex-col gap-8 w-full" data-controller="anonymous-participant">
                        <div class="flex flex-col">
                            {{ form_label(form.anonymous) }}
                            <label class="">
                                {{ form_widget(form.anonymous, {
                                    attr: {
                                        "data-anonymous-participant-target": "anonymous",
                                        "data-action": "change->anonymous-participant#update"
                                    }
                                }) }}
                                {% if form.anonymous.vars.required %}
                                    <twig:Atomic:RequiredBadge />
                                {% endif %}
                            </label>
                            {% if form.anonymous.vars.errors|length > 0 %}
                                <div class="alert alert-error alert-soft my-2">{{ form_errors(form.anonymous) }}</div>
                            {% endif %}
                        </div>
                        <div class="flex flex-col">
                            {{ form_label(form.pseudoAnonyme) }}
                            <label class="">
                                {{ form_widget(form.pseudoAnonyme, {
                                    attr: {
                                        'data-anonymous-participant-target': 'pseudo',
                                        'disabled': true
                                    }
                                }) }}
                                {% if form.pseudoAnonyme.vars.required %}
                                    <twig:Atomic:RequiredBadge />
                                {% endif %}
                            </label>
                            {% if form.pseudoAnonyme.vars.errors|length > 0 %}
                                <div class="alert alert-error alert-soft my-2">{{ form_errors(form.pseudoAnonyme) }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="card-actions flex md:flex-row flex-col-reverse md:justify-end justify-center md:gap-4 gap-2 my-6">
                        <button type="submit" class="btn btn-primary md:btn-md btn-lg md:w-48 w-full">Réserver le cadeau</button>
                        <a href="{{ gift_viewer_list_url(gift) }}" class="btn btn-soft md:btn-md btn-lg md:w-48 w-full">
                            Retour
                        </a>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
