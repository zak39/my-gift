{% extends 'base.html.twig' %}

{% block title %}My Gift | Détail du cadeau | {{ gift.title }}{% endblock %}

{% block body %}
<div class="flex flex-col justify-center items-center">
  <div class="card bg-base-100 p-6 card-sm md:m-9 m-3 md:w-5xl">
    <twig:Organism:GiftHeader :gift="gift" />         

    <div class="card-body flex md:flex-row gap-2 justify-center">
      <twig:Organism:ActionsButtons :gift="gift" />
    </div>

    <div class="card-body justify-center items-center">
      <twig:Organism:Contributors :gift="gift" />
    </div>
    <div class="card-actions justify-end">
      <twig:atomic:ButtonLink class="btn-outline btn-md flex justify-end mt-2 mb-8"
        name="Retour"
        type="neutral"
        :to="path('app_section', { id: gift.createdBy.id })"
        size="md">
        <twig:block name="name">
          <span>Retour</span>
        </twig:block>
      </twig:atomic:ButtonLink>
    </div>
  </div>
</div>
{% endblock %}
