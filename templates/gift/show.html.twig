{% extends 'base.html.twig' %}

{% block title %}My Gift | Détail du cadeau | {{ gift.title }}{% endblock %}

{% block body %}
<div class="mx-auto w-full max-w-6xl px-4 pb-12 md:px-8">
  <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

  <article class="mt-2 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
    <twig:Organism:Gift:Thumbnail :gift="gift"
      class="lg:col-span-5 lg:sticky lg:top-6 lg:self-start"
      imageClass="aspect-square w-full rounded-box bg-base-200 object-cover object-center"
      loading="eager" />

    <div class="flex min-w-0 flex-col gap-8 lg:col-span-7">
      <twig:Organism:GiftHeader :gift="gift" />

      <twig:Molecule:Gift:Journey :gift="gift" />

      <twig:Organism:ActionsButtons :gift="gift" />

      <twig:Organism:Contributors :gift="gift" />

      <div>
        <twig:atomic:ButtonLink class="btn-ghost btn-sm"
          :to="btnReturn|default(null) ?: gift_viewer_list_url(gift)">
          <twig:block name="icon">
            <twig:ux:icon name="lucide:arrow-left" class="size-4" />
          </twig:block>
          <twig:block name="name">
            <span>Retour à la liste</span>
          </twig:block>
        </twig:atomic:ButtonLink>
      </div>
    </div>
  </article>
</div>
{% endblock %}
