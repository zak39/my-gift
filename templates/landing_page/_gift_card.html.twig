{#
    Static copy of CardGift for the landing page, as a visitor of someone else's list sees it.
    The real component needs a persisted Gift, a workflow and a logged-in user, so the markup
    is mirrored here instead: keep it in step with templates/components/CardGift.html.twig.

    Variables:
    - gift: { image, alt, title, price (number), description, status: 'created'|'reserved'|'contributing' }
    - reservedBy: { name, seed } when status is 'reserved'
    - pool: { total (number), participants: [seed, …] } when status is 'contributing'
#}
<div class="w-full max-w-5xl">
    <article class="card lg:card-side bg-base-100 border border-base-300 shadow-sm transition-shadow duration-200 hover:shadow-md">
        <figure class="bg-base-200 lg:w-72 lg:shrink-0 xl:w-80">
            <img
                class="h-56 w-full object-contain p-4 sm:h-72 lg:h-full"
                src="{{ gift.image }}"
                alt="{{ gift.alt }}"
                width="400"
                height="400"
                loading="lazy" />
        </figure>

        <div class="card-body gap-0">
            <div class="flex items-center justify-between gap-3">
                <twig:Molecule:Gift:StatusBadge :status="enum('App\\Enum\\GiftStatus').from(gift.status)" />
                <span class="btn btn-circle btn-ghost" aria-hidden="true">
                    <twig:ux:icon class="size-5" name="rivet-icons:heart" />
                </span>
            </div>

            <div class="mt-3">
                <h3 class="text-base leading-snug font-semibold wrap-anywhere md:text-lg">{{ gift.title }}</h3>
                <p class="mt-1 text-2xl font-bold tabular-nums md:text-3xl">{{ gift.price|format_currency('EUR') }}</p>
            </div>

            <p class="mt-4 text-sm text-base-content/70 md:text-base">{{ gift.description }}</p>

            {% if gift.status == 'contributing' %}
                {{ include('landing_page/_contribution_bar.html.twig', {
                    title: gift.title,
                    price: gift.price,
                    total: pool.total,
                }, with_context = false) }}

                <div class="flex items-center gap-3 md:my-2 my-3 text-sm">
                    <div class="avatar-group -space-x-3">
                        {% for seed in pool.participants %}
                            <div class="avatar">
                                <div class="size-8 rounded-full">
                                    <img src="https://api.dicebear.com/10.x/thumbs/svg?seed={{ seed }}" alt="" width="64" height="64" loading="lazy" />
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    <span class="text-base-content/80">{{ pool.participants|length }} participants à la cagnotte</span>
                </div>
            {% elseif gift.status == 'reserved' %}
                <div class="flex items-center gap-3 md:my-2 my-3 text-sm">
                    <div class="avatar shrink-0">
                        <div class="size-8 rounded-full">
                            <img src="https://api.dicebear.com/10.x/thumbs/svg?seed={{ reservedBy.seed }}" alt="Photo de profil {{ reservedBy.name }}" width="64" height="64" loading="lazy" />
                        </div>
                    </div>
                    <div class="min-w-0 leading-tight wrap-anywhere">
                        <span class="font-bold md:text-base text-sm">{{ reservedBy.name }}</span>
                        <span class="text-base-content/80 md:text-base text-sm">a réservé ce cadeau</span>
                    </div>
                </div>
            {% endif %}

            <div class="mt-auto flex flex-col gap-3 border-t border-base-300 pt-4 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
                <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center">
                    {% if gift.status == 'contributing' %}
                        <span class="btn btn-primary md:w-52 w-full">
                            <twig:ux:icon name="ri:hand-coin-fill" />
                            Participer au cadeau
                        </span>
                    {% elseif gift.status == 'created' %}
                        <span class="btn btn-primary md:w-60 w-full">
                            <twig:ux:icon name="famicons:gift" />
                            Offrir le cadeau
                        </span>
                    {% endif %}
                    <span class="btn btn-outline md:w-52 w-full">
                        <twig:ux:icon name="fluent:eye-12-filled" />
                        Voir
                    </span>
                </div>

                <div class="flex flex-wrap items-center justify-end gap-1">
                    <span class="tooltip" data-tip="Copier le lien du cadeau">
                        <span class="btn btn-ghost btn-circle">
                            <twig:ux:icon name="lucide:share" />
                            <span class="sr-only">Partager</span>
                        </span>
                    </span>
                    <span class="tooltip" data-tip="Aller sur la boutique">
                        <span class="btn btn-ghost btn-circle">
                            <twig:ux:icon name="akar-icons:link-out" />
                            <span class="sr-only">Aller sur la boutique</span>
                        </span>
                    </span>
                </div>
            </div>
        </div>
    </article>
</div>
