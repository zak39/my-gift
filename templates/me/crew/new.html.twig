{% extends 'base.html.twig' %}

{% block title %}My Gift | Créer un groupe{% endblock %}

{% block body %}
{% form_theme form 'form/daisyui_layout.html.twig' %}

<div class="mx-auto w-full max-w-2xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Organism:Form:Card
        icon="lucide:users"
        title="Créer un groupe"
        description="Les membres d'un groupe tiennent une liste de cadeaux ensemble. Comme pour leurs propres listes, ils ne voient pas qui y offre quoi.">
        {{ form_start(form) }}
            <div class="flex flex-col gap-4 border-t border-base-300 p-5 sm:p-7">
                {{ form_errors(form) }}
                {{ form_row(form.name, { attr: { autofocus: true } }) }}
            </div>

            <twig:Molecule:Form:Actions
                :cancelUrl="path('app_crew')"
                submitLabel="Créer le groupe"
                submitIcon="lucide:users" />
        {{ form_end(form) }}
    </twig:Organism:Form:Card>
</div>
{% endblock %}
