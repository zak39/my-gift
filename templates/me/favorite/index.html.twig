{% extends 'base.html.twig' %}

{% block title %}My Gift | Mes favoris{% endblock %}

{% block body %}
{# Favourites are always someone else's gifts: the heart is hidden on your own cards. #}

<div class="mx-auto w-full max-w-6xl py-6 pb-12">
    <header>
        <h1 class="text-2xl leading-tight font-bold sm:text-3xl">Mes favoris</h1>
        {% if giftCount > 0 %}
            <p class="mt-2 flex items-center gap-2 text-sm text-muted">
                <twig:ux:icon name="lucide:heart" class="size-4 shrink-0" />
                <span class="tabular-nums">
                    {{ giftCount }} cadeau{{ giftCount > 1 ? 'x' : '' }} mis de côté
                    {%- if friendCount > 0 %} chez {{ friendCount }} ami{{ friendCount > 1 ? 's' }}{% endif %}
                    {%- if friendCount > 0 and crewCount > 0 %} et{% endif %}
                    {%- if crewCount > 0 %} dans {{ crewCount }} groupe{{ crewCount > 1 ? 's' }}{% endif %}
                </span>
            </p>
        {% endif %}
    </header>

    {% if favoriteGiftsByList is not empty %}
        <div class="mt-6 flex flex-col gap-8">
            {% for group in favoriteGiftsByList %}
                {# A crew's gifts under their crew, whoever added them; any other under its friend. #}
                <article class="flex min-w-0 flex-col gap-4">
                    <div class="flex items-center gap-3">
                        {% if group.crew %}
                            <twig:Molecule:UserAvatarGroup class="shrink-0" :users="group.crew.members" :max="3" sizeClass="w-10" />
                        {% else %}
                            <twig:Molecule:UserAvatar :user="group.user" sizeClass="h-12 w-12 shrink-0" />
                        {% endif %}
                        <h2 class="min-w-0 flex-1 text-lg font-semibold wrap-anywhere line-clamp-2 sm:line-clamp-none"
                            title="{{ group.name }}">
                            {{ group.name|u.truncate(90, '...', false) }}
                        </h2>
                        <twig:Atomic:ButtonLink
                            class="btn-sm shrink-0"
                            style="ghost"
                            :to="group.crew ? path('app_crew_show', { id: group.crew.id }) : path('app_section_user_page', { id: group.user.id })">
                            <twig:block name="name">
                                <span>{{ group.crew ? 'Voir le groupe' : 'Voir ses sections' }}</span>
                            </twig:block>
                            <twig:block name="icon">
                                <twig:ux:icon name="lucide:arrow-right" class="size-4" />
                            </twig:block>
                        </twig:Atomic:ButtonLink>
                    </div>

                    {% for entry in group.sections %}
                        <twig:Molecule:Section
                            :title="entry.section.title"
                            :description="entry.section.description"
                            :checked="loop.first"
                            :anchor="'favoris-' ~ entry.section.id"
                            :giftCount="entry.gifts|length">
                            <twig:block name="gifts">
                                {% for gift in entry.gifts %}
                                    <twig:CardGift :gift="gift" />
                                {% endfor %}
                            </twig:block>
                        </twig:Molecule:Section>
                    {% endfor %}
                </article>
            {% endfor %}
        </div>
    {% else %}
        <twig:Molecule:EmptyContentHero class="mt-6"
            title="Vous n'avez pas encore mis de cadeau en favoris"
            description="Parcourez les sections de vos amis et gardez sous la main les cadeaux qui vous plaisent.">
            <twig:block name="action_buttons">
                {# Solid primary: the single call to action of an otherwise empty page. #}
                <twig:Atomic:ButtonLink
                    color="primary"
                    style=""
                    :to="path('app_user')">
                    <twig:block name="icon">
                        <twig:ux:icon name="lucide:users" class="size-4" />
                    </twig:block>
                    <twig:block name="name">
                        <span>Commencez par trouver vos amis</span>
                    </twig:block>
                </twig:Atomic:ButtonLink>
            </twig:block>
        </twig:Molecule:EmptyContentHero>
    {% endif %}
</div>
{% endblock %}
