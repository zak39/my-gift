{% extends 'base.html.twig' %}

{% block title %}My Gift | Les sections de mes cadeaux{% endblock %}

{% block body %}
{# The user's own list (/me/sections): only its owner ever sees this page. #}
{# The crews' sections count too: they show inline, below the user's own. #}
{% set hasContent = sections|length > 0 or giftsWithoutSection|length > 0
    or crews|filter(crew => crew.sections is not empty)|length > 0 %}

<div class="mx-auto w-full max-w-6xl py-6 pb-12">
    <twig:Molecule:Flashes />

    <twig:Organism:GiftListHeader
        :user="user"
        :sections="sections"
        :giftsWithoutSection="giftsWithoutSection"
        :crews="crews"
        :ownerView="true" />

    {% if hasContent %}
        <div class="mt-6 flex flex-col gap-6 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start">
            <twig:Molecule:SectionNav
                :sections="sections"
                :giftsWithoutSection="giftsWithoutSection"
                :includeDrafts="true"
                :crews="crews" />

            <div class="flex min-w-0 flex-col gap-5">
                <twig:Organism:Section:Listing :sections="sections" :ownerView="true" />

                {% if giftsWithoutSection|length > 0 %}
                    <twig:Molecule:Section
                        title="Cadeaux sans section"
                        description="Les cadeaux qui n'ont pas encore été rangés dans une section."
                        anchor="section-sans-section"
                        :checked="true"
                        :giftCount="giftsWithoutSection|length">
                        <twig:block name="gifts">
                            <twig:Molecule:Gift:UnfiledHint />
                            {% for gift in giftsWithoutSection %}
                                <twig:CardGift :gift="gift" :headingLevel="3" />
                            {% endfor %}
                        </twig:block>
                    </twig:Molecule:Section>
                {% endif %}

                <twig:Organism:Crew:SharedLists class="mt-5" :crews="crews" :user="user" :ownerView="true" />
            </div>
        </div>
    {% else %}
        <div class="mt-6">
        <twig:Molecule:EmptyContentHero
            title="Pas encore de cadeau ni de section"
            description="Ajoutez un premier cadeau, puis rangez vos idées dans des sections comme « Geek » ou « Sport ».">
            <twig:block name="action_buttons">
                <div class="flex flex-col justify-center gap-2 sm:flex-row">
                    <twig:Atomic:ButtonLink
                        color="primary"
                        style="block"
                        :to="path('app_gift_create')">
                        <twig:block name="icon">
                            <twig:ux:icon name="lucide:plus" class="size-4" />
                        </twig:block>
                        <twig:block name="name">
                            <span>Ajouter un cadeau</span>
                        </twig:block>
                    </twig:Atomic:ButtonLink>
                    <twig:Atomic:ButtonLink
                        style="outline"
                        :to="path('app_section_new')">
                        <twig:block name="icon">
                            <twig:ux:icon name="lucide:folder-plus" class="size-4" />
                        </twig:block>
                        <twig:block name="name">
                            <span>Créer une section</span>
                        </twig:block>
                    </twig:Atomic:ButtonLink>
                </div>
            </twig:block>
        </twig:Molecule:EmptyContentHero>
        </div>

        <twig:Organism:Crew:SharedLists class="mt-10" :crews="crews" :user="user" :ownerView="true" />
    {% endif %}

</div>
{% endblock %}
