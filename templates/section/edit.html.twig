{% extends 'base.html.twig' %}

{% block title %}My Gift | Modifier une section{% endblock %}

{% block body %}
{% form_theme form 'form/daisyui_layout.html.twig' %}

{% set giftCount = section.gifts|length %}

<div class="mx-auto w-full max-w-2xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Organism:Form:Card icon="lucide:folder-pen" title="Modifier la section">
        <twig:block name="meta">
            <p class="flex items-center gap-2 text-sm text-base-content/70">
                <twig:ux:icon name="lucide:gift" class="size-4 shrink-0" />
                <span class="tabular-nums">
                    {% if giftCount > 0 %}
                        {{ giftCount }} cadeau{{ giftCount > 1 ? 'x' }} rangé{{ giftCount > 1 ? 's' }} dedans
                    {% else %}
                        Aucun cadeau rangé dedans pour l’instant
                    {% endif %}
                </span>
            </p>
        </twig:block>

        {{ form_start(form) }}
            <div class="flex flex-col gap-4 border-t border-base-300 p-5 sm:p-7">
                {{ form_errors(form) }}
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
            </div>

            <twig:Molecule:Form:Actions
                :cancelUrl="section.crew ? path('app_crew_show', { id: section.crew.id }) : path('app_section', { id: app.user.id })"
                submitLabel="Enregistrer les modifications" />
        {{ form_end(form) }}
    </twig:Organism:Form:Card>
</div>
{% endblock %}
