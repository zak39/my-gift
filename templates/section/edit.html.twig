{% extends 'base.html.twig' %}

{% block title %}Editer la section{% endblock %}

{% block body %}
<div class="flex justify-center my-16">
    <div class="flex flex-col items-center md:w-4xl w-full">
        <h1 class="text-xl self-baseline mb-4">Editer la Section</h1>
        {{ form_start(form, { "attr": { "class": "w-full" } }) }}
            <div class="flex flex-col gap-8 w-full">
                <div class="flex flex-col">
                    {{ form_label(form.title) }}
                    {{ form_widget(form.title) }}
                </div>
                <div class="flex flex-col">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                </div>
                {{ form_errors(form) }}
                <div class="flex md:flex-row flex-col-reverse md:justify-between md:gap-0 gap-2 my-6">
                    <button type="submit" class="btn btn-primary md:w-3xs md:btn-md btn-lg w-full">Editer la section</button>
                    <button class="btn btn-soft md:w-3xs md:btn-md btn-lg w-full">
                        <a href={{ path('app_section', { 'id': user.id }) }}>
                            Retour
                        </a>
                    </button>
                </div>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
