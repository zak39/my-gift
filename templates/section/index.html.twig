{% extends 'base.html.twig' %}

{% block title %}My Gift | Les sections de mes cadeaux{% endblock %}

{% block body %}
<div class="flex md:flex-row flex-col md:items-center items-start justify-between my-6 md:gap-0 gap-8">
    <h1 class="text-xl">Mes sections de cadeau</h1>
    <div class="flex gap-4 md:flex-row flex-col justify-end">
        {% if sections is not empty %}
            {% if app.user == user %}
                <twig:atomic:ButtonLink class="btn-md"
                    style="ghost"
                    :to="path('app_section_new')">
                    <twig:block name="name">
                        <span>Créer une section</span>
                    </twig:block>
                </twig:atomic:ButtonLink>
                <twig:atomic:ButtonLink class="btn-md"
                    style="ghost"
                    :to="path('app_gift_create')">
                    <twig:block name="name">
                        <span>Créer un cadeau</span>
                    </twig:block>
                </twig:atomic:ButtonLink>
            {% endif %}
        {% endif %}
    </div>
</div>

{% for message in app.flashes('success') %}
    <twig:Alert type="success" :message="message" />
{% endfor %}
<div class="flex flex-col gap-6 my-8">
    {% if sections is not empty %}
        <twig:molecule:Section title="Cadeaux sans section"
            description="Les cadeaux qui ne sont pas encore dans une section.">
            <twig:block name="gifts">
                {% for gift in giftsWithoutSection %}
                    <twig:CardGift :gift="gift" />
                {% endfor %}
            </twig:block>
        </twig:molecule:Section>        
    {% endif %}

    {% for section in sections %}
        <twig:molecule:Section :title="section.title"
            :description="section.description">
            <twig:block name="gifts">
                {% for gift in section.gifts %}
                    <twig:CardGift :gift="gift" />
                {% endfor %}
            </twig:block>
            <twig:block name="actionButtons">
                {% if app.user == user %}
                    <twig:atomic:ButtonLink
                        type="neutral"
                        style="ghost"
                        :to="path('app_section_edit', { id: section.id })">
                        <twig:block name="name">
                            <span>Editer</span>
                        </twig:block>
                    </twig:atomic:ButtonLink>
                    <twig:Modal :id="section.id"
                        :title="section.title"
                        class="remove_section">
                        <twig:block name="handlerButton">
                            <twig:atomic:Button
                                type="neutral"
                                style="ghost"
                                onclick="modal_remove_section_{{ section.id }}.showModal()">
                                <twig:block name="name">
                                    <span>Supprimer</span>
                                </twig:block>
                            </twig:atomic:Button>
                        </twig:block>
                        <twig:block name="message">
                            <p class="py-4">Est-ce que vous êtes sûr de supprimer la section <b>{{ section.title }}</b> ?</p>
                            <p class="py-4">La suppression de la section ne supprimera pas les cadeaux. Ils seront déplacer dans la section <b>Cadeaux sans Section</b></p>
                        </twig:block>
                        <twig:block name="actionButtons">
                            <form method="post" action="{{ path('app_section_delete', { id: section.id }) }}">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn btn-outline btn-secondary">
                                    <twig:ux:icon name="heroicons:trash-16-solid" />
                                    Supprimer
                                </button>
                            </form>
                        </twig:block>
                    </twig:Modal>
                {% endif %}
            </twig:block>
        </twig:molecule:Section>

        {% else %}
            <twig:molecule:EmptyContentHero
                title="Vous n'avez pas encore créé de section" 
                description="Commencez à créer votre première section">
                <twig:block name="action_buttons">
                    <twig:atomic:ButtonLink class="md:btn-md btn-lg"
                        :to="path('app_section_new')">
                        <twig:block name="name">
                            <span>Créer votre première section</span>
                        </twig:block>
                    </twig:atomic:ButtonLink>
                </twig:block>
            </twig:molecule:EmptyContentHero>
    {% endfor %}
</div>
{% endblock %}
