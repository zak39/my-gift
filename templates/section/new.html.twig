{% extends 'base.html.twig' %}

{% block title %}My Gift | Créer une section{% endblock %}

{% block body %}
{% form_theme form 'form/daisyui_layout.html.twig' %}

<div class="mx-auto w-full max-w-2xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Organism:Form:Card
        icon="lucide:folder-plus"
        title="Créer une section"
        description="Rangez vos idées par thème, comme « Geek » ou « Sport » : vos amis verront vos cadeaux regroupés sous ce titre.">
        {{ form_start(form) }}
            <div class="flex flex-col gap-4 border-t border-base-300 p-5 sm:p-7">
                {{ form_errors(form) }}
                {# Only for a member of a crew: the list is theirs otherwise. #}
                {% if form.crew is defined %}
                    {{ form_row(form.crew) }}
                {% endif %}
                {{ form_row(form.title, { attr: { autofocus: true } }) }}
                {{ form_row(form.description) }}
            </div>

            <twig:Molecule:Form:Actions
                :cancelUrl="section.crew ? path('app_crew_show', { id: section.crew.id }) : path('app_section', { id: app.user.id })"
                submitLabel="Créer la section"
                submitIcon="lucide:folder-plus" />
        {{ form_end(form) }}
    </twig:Organism:Form:Card>
</div>
{% endblock %}
