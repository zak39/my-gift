{% extends 'base.html.twig' %}

{% block title %}My Gift | Liste des cadeaux de {{ user.firstname }} {{ user.lastname }} {% endblock %}

{% block body %}
{# The controller only sends public gifts without section, and only to the owner. #}
{% set hasContent = sections|length > 0 or giftsWithoutSection|length > 0 %}

<div class="mx-auto w-full max-w-6xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    {% for message in app.flashes('success') %}
        <twig:Alert type="success" :message="message" class="mb-4" />
    {% endfor %}

    <twig:Organism:GiftListHeader
        :user="user"
        :sections="sections"
        :giftsWithoutSection="giftsWithoutSection" />

    {% if hasContent %}
        <div class="mt-6 grid items-start gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
            <twig:Molecule:SectionNav
                class="lg:sticky lg:top-6"
                :sections="sections"
                :giftsWithoutSection="giftsWithoutSection" />

            <div class="flex min-w-0 flex-col gap-5">
                {% for section in sections %}
                    <twig:molecule:Section
                        :title="section.title"
                        :description="section.description"
                        :checked="loop.first"
                        :anchor="'section-' ~ section.id"
                        :giftCount="section.gifts|filter(gift => gift.isPublic)|length">
                        <twig:block name="gifts">
                            {% for gift in section.gifts|filter(gift => gift.isPublic) %}
                                <twig:CardGift :gift="gift" />
                            {% else %}
                                <p class="py-4 text-sm text-base-content/70">
                                    Aucun cadeau publié dans cette section pour le moment.
                                </p>
                            {% endfor %}
                        </twig:block>
                        <twig:block name="actionButtons">
                            <twig:Organism:Section:Actions :section="section" />
                        </twig:block>
                    </twig:molecule:Section>
                {% endfor %}

                {% if giftsWithoutSection|length > 0 %}
                    <twig:molecule:Section
                        title="Cadeaux sans section"
                        description="Les cadeaux qui n'ont pas encore été rangés dans une section."
                        anchor="section-sans-section"
                        :giftCount="giftsWithoutSection|length">
                        <twig:block name="gifts">
                            {% for gift in giftsWithoutSection %}
                                <twig:CardGift :gift="gift" />
                            {% endfor %}
                        </twig:block>
                    </twig:molecule:Section>
                {% endif %}
            </div>
        </div>
    {% else %}
        <twig:molecule:EmptyContent class="mt-6"
            title="Mince ! {{ user.firstname }} n'a pas encore de cadeau à offrir 😥"
            description="Revenez plus tard pour lui offrir un joli cadeau 😉" />
    {% endif %}

    <div class="mt-8 flex justify-start">
        <twig:atomic:ButtonLink
            color="neutral"
            style="ghost"
            :to="btnReturn|default(null) ?: path('app_user')">
            <twig:block name="icon">
                <twig:ux:icon name="lucide:arrow-left" class="size-4" />
            </twig:block>
            <twig:block name="name">
                <span>Retour</span>
            </twig:block>
        </twig:atomic:ButtonLink>
    </div>
</div>
{% endblock %}
