{# The login card, shared by the login page and the landing page. autofocus defaults to true.
   joined (false by default): the card is the left half of a wider card, whose shadow and width the
   login page gives (Molecule:Auth:SwitchPanel on its right), and it is given more room. #}
{% set autofocus = autofocus ?? true %}
{% set joined = joined ?? false %}
{% set bodyClass = joined ? 'card-body gap-6 p-8 sm:p-12' : 'card-body' %}
{% set fieldsetClass = joined ? 'fieldset gap-5' : 'fieldset' %}

<div class="card bg-base-100 w-full {{ joined ? 'lg:flex-1 rounded-none' : 'max-w-sm shrink-0 shadow-2xl' }}">
    <div class="{{ bodyClass }}">
        {# On the login page, the page's heading is the card's, as on the registration page. The landing
           page has its own above its card. #}
        {% if joined %}
            <div class="card-title">
                <h1>Connectez-vous !</h1>
            </div>
            {# A link shared with "Partager", opened while logged out (SharedLinkPreviewListener). #}
            <p>
                {% if linkPreview is defined %}
                    On vous partage « {{ linkPreview.title }} » : connectez-vous pour le découvrir 🎁
                {% else %}
                    Connectez-vous pour regarder qui vous a offert un joli cadeau 🎁
                {% endif %}
            </p>
        {% endif %}
        {% for flash_success in app.flashes('success') %}
            <twig:Alert type="success" :message="flash_success" />
        {% endfor %}

        <form method="post" action="{{ path('app_login') }}">
            <fieldset class="{{ fieldsetClass }}">
            {# An email or a pseudo (UserRepository::loadUserByIdentifier()): a text field, and
               "username", the autocomplete token for a login identifier (RGAA 11.13). RGAA 11.1:
               a placeholder is no label, the sr-only label gives the field its name. #}
            <label for="username" class="sr-only">Email ou pseudo</label>
            <div class="input w-full">
                <svg aria-hidden="true" class="h-[1em] opacity-50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <g
                    stroke-linejoin="round"
                    stroke-linecap="round"
                    stroke-width="2.5"
                    fill="none"
                    stroke="currentColor"
                    >
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                    </g>
                </svg>
                <input type="text" value="{{ last_username|default('') }}" name="_username" id="username" autocomplete="username" required {{ autofocus ? 'autofocus' : '' }} placeholder="Email ou pseudo" />
            </div>
            <twig:Molecule:Auth:PasswordField />
            <div><a class="link link-hover" href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a></div>
            {# Only after a login refused for an unconfirmed address (SecurityController::login()). #}
            {% if emailUnverified ?? false %}
                <div><a class="link link-hover" href="{{ path('app_verify_resend', { invitation: invitation ?? null }) }}">Pas reçu l'email de confirmation ?</a></div>
            {% endif %}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            {# A shared link opened while logged out (SharedLinkPreviewListener): back to it once logged in. #}
            {% if target_path is defined %}
                <input type="hidden" name="_target_path" value="{{ target_path }}">
            {% endif %}

            <div class="flex items-center gap-1.5 my-4">
                <input type="checkbox" class="checkbox checkbox-primary" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn btn-primary mt-4">Se connecter</button>
            </fieldset>
        </form>
    </div>
</div>
