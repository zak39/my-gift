{% extends 'base.html.twig' %}

{% block title %}My Gift | Se connecter{% endblock %}

{% block body %}
<div class="hero bg-base-200 min-h-screen">
    <div class="flex w-full max-w-4xl flex-col-reverse">
        {% if emailUnverified %}
            <div role="alert" class="alert alert-warning">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% elseif error %}
            <div role="alert" class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0 stroke-current" fill="none" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}
        <div class="hero-content w-full flex-col gap-12 py-16">
            {% if app.user %}
                <div class="card mb-3">
                    <p>Vous êtes déjà connecté en tant que {{ app.user.userIdentifier }}.</p>
                    <a class="btn btn-outline my-4" href="{{ logout_path() }}">Se déconnecter</a>
                </div>
            {% else %}
                {# One card in two halves: the login, and the way to an account. #}
                <twig:Molecule:Auth:SplitCard page="login">
                    {{ include('security/_login_form.html.twig', { joined: true }) }}
                </twig:Molecule:Auth:SplitCard>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
