{# The navbar's face: without an avatar, the placeholder already there stays. #}
{% set source = user_avatar_url(user) %}
{% if source %}
    <twig:Turbo:Stream:Replace target="#user_avatar_header">
        <twig:Atomic:Image id="user_avatar_header" :source="source" alt="Photo de profil {{ user.fullname }}" />
    </twig:Turbo:Stream:Replace>
{% endif %}

<twig:Turbo:Stream:Replace target="#user_avatar_settings">
    <twig:Molecule:User:ProfileAvatar :user="user" />
</twig:Turbo:Stream:Replace>
