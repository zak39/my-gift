<twig:Turbo:Stream:Replace target="#user_avatar_header">
    <twig:atomic:Image id="user_avatar_header"
      source="{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : vich_uploader_asset(app.user, 'avatarDefaultFile') }}"
      alt="Photo de profil {{ user.firstname }} {{ user.lastname }}" />
</twig:Turbo:Stream:Replace>

<twig:Turbo:Stream:Replace target="#user_avatar_settings">
    <twig:atomic:Image id="user_avatar_settings"
      source="{{ user.avatar ? vich_uploader_asset(user, 'avatarFile') : vich_uploader_asset(app.user, 'avatarDefaultFile') }}"
      alt="Photo de profil {{ user.firstname }} {{ user.lastname }}" />
</twig:Turbo:Stream:Replace>
