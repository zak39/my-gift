{% extends 'base.html.twig' %}

{% block title %}My Gift | Sections de {{ user.pseudo }}{% endblock %}

{% block body %}
{# The controller only sends public gifts without section. #}
{# The crews count too, below the user's own sections, once they show the viewer a gift. #}
{% set hasContent = sections|length > 0 or giftsWithoutSection|length > 0
    or crews|filter(crew => crew.giftCount(is_granted('crew.is_member', crew)) > 0)|length > 0 %}

<div class="mx-auto w-full max-w-6xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Molecule:Flashes />

    <twig:Organism:GiftListHeader
        :user="user"
        :sections="sections"
        :giftsWithoutSection="giftsWithoutSection" />

    {% if hasContent %}
        <div class="mt-6 flex flex-col gap-6 lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:items-start">
            <twig:Molecule:SectionNav
                :sections="sections"
                :giftsWithoutSection="giftsWithoutSection"
                :crews="crews" />

            {# Open the first block a friend has something to see in: a section with a published
               gift, or else the gifts filed in none. #}
            {% set openSection = sections|filter(section => section.visibleGifts(false)|length > 0)|first %}
            <div class="flex min-w-0 flex-col gap-5">
                <twig:Organism:Section:Listing :sections="sections" :unfoldFirst="false" :unfolded="openSection" />

                {% if giftsWithoutSection|length > 0 %}
                    <twig:Molecule:Section
                        title="Cadeaux sans section"
                        description="Les cadeaux qui n'ont pas encore été rangés dans une section."
                        anchor="section-sans-section"
                        :checked="openSection is empty"
                        :giftCount="giftsWithoutSection|length">
                        <twig:block name="gifts">
                            {# The owner previewing their page; their friends see the gifts alone. #}
                            {% if is_granted('user.is_owner', user) %}
                                <twig:Molecule:Gift:UnfiledHint />
                            {% endif %}
                            {% for gift in giftsWithoutSection %}
                                <twig:CardGift :gift="gift" :headingLevel="3" />
                            {% endfor %}
                        </twig:block>
                    </twig:Molecule:Section>
                {% endif %}

                <twig:Organism:Crew:SharedLists class="mt-5" :crews="crews" :user="user" />
            </div>
        </div>
    {% else %}
        <twig:Molecule:EmptyContent class="mt-6"
            title="Mince ! {{ user.pseudo }} n'a pas encore de cadeau à offrir 😥"
            description="Revenez plus tard pour lui offrir un joli cadeau 😉" />

        <twig:Organism:Crew:SharedLists class="mt-10" :crews="crews" :user="user" />
    {% endif %}

    <div class="mt-8 flex justify-start">
        <twig:Atomic:ButtonLink
            style="ghost"
            :to="btnReturn">
            <twig:block name="icon">
                <twig:ux:icon name="lucide:arrow-left" class="size-4" />
            </twig:block>
            <twig:block name="name">
                <span>Retour</span>
            </twig:block>
        </twig:Atomic:ButtonLink>
    </div>
</div>
{% endblock %}
