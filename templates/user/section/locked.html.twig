{% extends 'base.html.twig' %}

{% block title %}My Gift | {{ user.fullname }}{% endblock %}

{% block body %}
{# What a non-friend sees on /users/{id}/sections, LinkedIn-style: the header stays,
   the list gives way to the friendship buttons. #}
<div class="mx-auto w-full max-w-6xl pb-12">
    <twig:Molecule:Breadcrumbs :items="breadcrumbs" />

    <twig:Molecule:Flashes />

    <twig:Organism:GiftListHeader :user="user" />

    <twig:Molecule:EmptyContent class="mt-6"
        title="Les sections de {{ user.firstname }} sont réservées à ses ami·es 🔒"
        description="Dès que votre demande sera acceptée, vous verrez ses cadeaux et {{ user.firstname }} verra les vôtres.">
        <twig:block name="action_buttons">
            <twig:Molecule:Friend:ActionButtons class="mt-6 justify-center" :user="user" />
        </twig:block>
    </twig:Molecule:EmptyContent>
</div>
{% endblock %}
